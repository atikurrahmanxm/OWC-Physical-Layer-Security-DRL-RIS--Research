pan id="labelEvePos">(3.20, 3.40, 0.85) m</span>\n        </div>\n        <div class="slider-row">\n          <label>X (m):</label>\n          <input type="range" id="slEveX" min="0.2" max="4.8" step="0.05" value="3.2">\n          <span id="vEveX">3.20</span>\n        </div>\n        <div class="slider-row">\n          <label>Y (m):</label>\n          <input type="range" id="slEveY" min="0.2" max="4.8" step="0.05" value="3.4">\n          <span id="vEveY">3.40</span>\n        </div>\n        <div id="distanceAlert" class="alert-banner alert-safe">\n          <span>\U0001f4cf Bob-Eve Dist:</span>\n          <strong id="vDistance">2.28 m</strong>\n          <span id="vDistanceStatus">(Safe Separation)</span>\n        </div>\n      </div>\n\n      <!-- Operating SNR -->\n      <div class="control-box">\n        <div class="control-head">\n          <span style="color: var(--accent-gold)">Operating SNR & Channel</span>\n          <span id="labelSnr">12.0 dB</span>\n        </div>\n        <div class="slider-row">\n          <label>SNR:</label>\n          <input type="range" id="slSnr" min="4.0" max="20.0" step="0.5" value="12.0">\n          <span id="vSnr">12.0 dB</span>\n        </div>\n        <div class="slider-row">\n          <label>Index \u03b1:</label>\n          <input type="range" id="slAlpha" min="5" max="25" step="1" value="10">\n          <span id="vAlpha">10%</span>\n        </div>\n      </div>\n\n      <!-- Objective Weights -->\n      <div class="control-box">\n        <div class="control-head">\n          <span style="color: var(--accent-purple)">Utility Weights (Eq. 7)</span>\n        </div>\n        <div class="slider-row">\n          <label>\u03b4\u2081 (BER):</label>\n          <input type="range" id="slDelta1" min="1.0" max="6.0" step="0.2" value="3.5">\n          <span id="vDelta1">3.5</span>\n        </div>\n        <div class="slider-row">\n          <label>\u03b4\u2082 (Eng):</label>\n          <input type="range" id="slDelta2" min="0.1" max="1.5" step="0.05" value="0.4">\n          <span id="vDelta2">0.40</span>\n        </div>\n      </div>\n\n      <div style="font-size: 0.68rem; color: var(--text-muted); line-height: 1.4; margin-top: auto;">\n        \U0001f4a1 <strong>Live Dynamic Synchronization:</strong> Every change in Eve, Bob, or SNR updates the 3D surface vortex, convergence curves, and SNR curves at 60 FPS!\n      </div>\n    </div>\n\n    <!-- CENTER: Main Live Figures Stage -->\n    <div class="center-section">\n\n      <!-- Transmission Ribbon -->\n      <div class="trans-ribbon">\n        <div class="trans-left">\n          <button id="btnTransPlay" class="btn-trans-toggle" onclick="toggleTransmission()">\n            <span id="transIcon">\u23f8</span> <span id="transText">LIVE TRANSMITTING</span>\n          </button>\n          <button id="btnEvePatrol" class="btn-patrol" onclick="toggleEvePatrol()">\n            \U0001f6b6 Eve Auto-Move: <span id="patrolEveStatus">OFF</span>\n          </button>\n          <button id="btnBobPatrol" class="btn-patrol btn-patrol-bob" onclick="toggleBobPatrol()">\n            \U0001f6b6 Bob Auto-Move: <span id="patrolBobStatus">OFF</span>\n          </button>\n          <div class="speed-group">\n            <span>Speed:</span>\n            <button class="btn-speed active" id="spd1" onclick="setSpeed(1)">1x</button>\n            <button class="btn-speed" id="spd2" onclick="setSpeed(2)">2x</button>\n            <button class="btn-speed" id="spd5" onclick="setSpeed(5)">5x</button>\n          </div>\n        </div>\n\n        <div class="trans-right">\n          <div class="trans-badge"><span class="k-label">Slot:</span> <strong id="dispSlot" style="color: #60a5fa;">k = 1 / 2000</strong></div>\n          <div class="trans-badge"><span class="k-label">Secret Bits:</span> <strong id="dispBits" style="color: #34d399;">0 kb</strong></div>\n          <div class="trans-badge"><span class="k-label">Nulling:</span> <strong style="color: #c084fc;">Active</strong></div>\n        </div>\n      </div>\n\n      <!-- Main Stage Container -->\n      <div class="viewer-stage">\n        \n        <!-- Tab Navigation Bar -->\n        <div class="view-switcher-bar">\n          <div class="main-tabs">\n            <button class="main-tab-btn" id="tabFig5" onclick="switchMainView(\'fig5\')">\U0001f310 Fig 5: 3D Spatial Secrecy Surface</button>\n            <button class="main-tab-btn" id="tabFig6" onclick="switchMainView(\'fig6\')">\U0001f4c8 Fig 6: Learning Convergence (2000 Slots)</button>\n            <button class="main-tab-btn" id="tabFig7" onclick="switchMainView(\'fig7\')">\u26a1 Fig 7: Performance vs SNR Curves</button>\n            <button class="main-tab-btn active" id="tabRoom" onclick="switchMainView(\'room3d\')">\U0001f3e0 3D Room & Light Beams</button>\n          </div>\n\n          <div class="style-toggle-box">\n            <button id="btnThemeToggle" class="btn-theme-toggle" onclick="togglePaperTheme()">\U0001f4c4 IEEE Paper Style (White)</button>\n          </div>\n        </div>\n\n        <!-- Sub-controls Bar -->\n        <div class="sub-controls-bar" id="subControlsBar">\n          <!-- Dynamically populated with sub-options (e.g. 5a/5b, 6a/6b/6c/combined) -->\n        </div>\n\n        <!-- High-Resolution Canvas Wrapper -->\n        <div class="primary-canvas-wrapper" id="canvasWrapper">\n          <!-- Floating HUD Zoom & Viewport Controls -->\n          <div class="canvas-hud">\n            <button class="hud-btn" onclick="zoomIn()" title="Zoom In (or scroll wheel)">\u2795 Zoom In</button>\n            <button class="hud-btn" onclick="zoomOut()" title="Zoom Out (or scroll wheel)">\u2796 Zoom Out</button>\n            <button class="hud-btn" onclick="resetZoom()" title="Reset Zoom">\U0001f504 Reset View</button>\n            <button class="hud-btn hud-expand-btn" id="btnToggleSidebars" onclick="toggleSidebars()" title="Toggle Fullscreen Width">\u26f6 Maximize Viewport</button>\n          </div>\n          <canvas id="stageCanvas"></canvas>\n        </div>\n\n      </div>\n\n    </div>\n\n    <!-- RIGHT: Telemetry & Live Data Matrix -->\n    <div class="panel" id="panelRight">\n      <div class="panel-title">\n        <span>\U0001f4e1 Live Telemetry & Calculations</span>\n      </div>\n\n      <!-- Cards -->\n      <div class="metric-grid">\n        <div class="metric-card mc-green">\n          <div class="mc-label">Secrecy Rate (c_s)</div>\n          <div class="mc-value" id="dispCs" style="color: #34d399;">3.23</div>\n          <div class="mc-sub">bps/Hz (vs 0.00 without jammer)</div>\n        </div>\n        <div class="metric-card mc-blue">\n          <div class="mc-label">Bob Bit Error Rate</div>\n          <div class="mc-value" id="dispBer" style="color: #60a5fa;">1.35e-08</div>\n          <div class="mc-sub">4PAM Demodulation (Eq. 14)</div>\n        </div>\n        <div class="metric-card mc-purple">\n          <div class="mc-label">Overall Utility (u)</div>\n          <div class="mc-value" id="dispUtility" style="color: #c084fc;">2.54</div>\n          <div class="mc-sub">u = c_s - \u03b4\u2081�p_e - \u03b4\u2082�E (Eq. 7)</div>\n        </div>\n        <div class="metric-card mc-cyan">\n          <div class="mc-label">Eve Jamming Power</div>\n          <div class="mc-value" id="dispEveJam" style="color: #22d3ee;">4.67e-05</div>\n          <div class="mc-sub">h_JE^T � w (Delivered Noise)</div>\n        </div>\n      </div>\n\n      <!-- Beamformer Bars -->\n      <div class="beamformer-block">\n        <div style="font-size: 0.67rem; color: var(--text-muted); font-weight: 600; display: flex; justify-content: space-between;">\n          <span>Zero-Forcing Beamformer w \u2208 [-1, 1]\u2074</span>\n          <span id="dispNullBob" style="color: #34d399; font-family: monospace;">Bob Leakage: 0.00e+00</span>\n        </div>\n        <div class="jammer-bars">\n          <div class="j-bar-item">\n            <div class="j-bar-label">Jammer 1</div>\n            <div class="j-bar-meter"><div class="j-bar-fill" id="fillJ1"></div></div>\n            <div class="j-bar-num" id="valJ1">-0.32</div>\n          </div>\n          <div class="j-bar-item">\n            <div class="j-bar-label">Jammer 2</div>\n            <div class="j-bar-meter"><div class="j-bar-fill" id="fillJ2"></div></div>\n            <div class="j-bar-num" id="valJ2">+0.26</div>\n          </div>\n          <div class="j-bar-item">\n            <div class="j-bar-label">Jammer 3</div>\n            <div class="j-bar-meter"><div class="j-bar-fill" id="fillJ3"></div></div>\n            <div class="j-bar-num" id="valJ3">+0.15</div>\n          </div>\n          <div class="j-bar-item">\n            <div class="j-bar-label">Jammer 4</div>\n            <div class="j-bar-meter"><div class="j-bar-fill" id="fillJ4"></div></div>\n            <div class="j-bar-num" id="valJ4">+1.00</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Live Scheme Table -->\n      <div style="font-size: 0.69rem; color: var(--text-muted); font-weight: 700; margin-top: 2px;">\n        LIVE SCHEME PERFORMANCE MATRIX\n      </div>\n      <table class="compare-table">\n        <thead>\n          <tr>\n            <th>Scheme</th>\n            <th>Secrecy Rate</th>\n            <th>Bob BER</th>\n            <th>Energy</th>\n            <th>Utility</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>No Jamming</td>\n            <td id="t_nj_cs">0.0000</td>\n            <td id="t_nj_ber">1.35e-08</td>\n            <td>0.00</td>\n            <td id="t_nj_u">-0.00</td>\n          </tr>\n          <tr>\n            <td>Zero-Forcing (Eq. 5)</td>\n            <td id="t_zf_cs">3.2301</td>\n            <td id="t_zf_ber">1.35e-08</td>\n            <td id="t_zf_e">1.73</td>\n            <td id="t_zf_u">2.5366</td>\n          </tr>\n          <tr>\n            <td>Proposed RL-FJ</td>\n            <td id="t_rl_cs">2.8777</td>\n            <td id="t_rl_ber">1.08e-07</td>\n            <td id="t_rl_e">1.43</td>\n            <td id="t_rl_u">2.3056</td>\n          </tr>\n          <tr class="row-highlight">\n            <td>Proposed DRL-FJ <span class="tag-best">BEST</span></td>\n            <td id="t_drl_cs">3.1655</td>\n            <td id="t_drl_ber">1.42e-08</td>\n            <td id="t_drl_e">1.24</td>\n            <td id="t_drl_u">2.6714</td>\n          </tr>\n          <tr>\n            <td>Theoretical Bound</td>\n            <td id="t_th_cs">3.2301</td>\n            <td id="t_th_ber">1.35e-08</td>\n            <td id="t_th_e">1.30</td>\n            <td id="t_th_u">2.7100</td>\n          </tr>\n        </tbody>\n      </table>\n\n      <!-- Channel table -->\n      <div style="font-size: 0.69rem; color: var(--text-muted); font-weight: 700; margin-top: 8px;">\n        ELECTRICAL CHANNEL GAINS h (A/W)\n      </div>\n      <table class="channel-table">\n        <thead>\n          <tr><th>Link</th><th>Channel</th><th>Live Value</th></tr>\n        </thead>\n        <tbody>\n          <tr><td>Alice -> Bob</td><td>h_AB</td><td id="ch_hAB">2.7183e-05</td></tr>\n          <tr><td>Alice -> Eve</td><td>h_AE</td><td id="ch_hAE">2.7183e-05</td></tr>\n          <tr><td>4 Jammers -> Bob</td><td>h_JB</td><td id="ch_hJB">[4.28e-5, ...]</td></tr>\n          <tr><td>4 Jammers -> Eve</td><td>h_JE</td><td id="ch_hJE">[7.71e-6, ...]</td></tr>\n        </tbody>\n      </table>\n    </div>\n\n  </div>\n\n  <script>\n    // =========================================================================\n    // 1. VLC CHANNEL PHYSICS & CORE ALGORITHMIC MATH\n    // =========================================================================\n    const ROOM = [5.0, 5.0, 3.0];\n    const ALICE = [2.5, 2.5, 3.0];\n    const JAMMERS = [\n      [1.5, 1.5, 3.0],\n      [1.5, 3.5, 3.0],\n      [3.5, 1.5, 3.0],\n      [3.5, 3.5, 3.0]\n    ];\n    const Ap = 1e-4, R = 0.54, n0 = 1.5, fov = Math.PI / 3.0;\n    const m_order = 1.0;\n    const g_conc = (n0 * n0) / (Math.sin(fov) * Math.sin(fov));\n\n    function getGain(tx, rx, n_led = 4) {\n      const dx = rx[0] - tx[0], dy = rx[1] - tx[1], dz = rx[2] - tx[2];\n      const d = Math.sqrt(dx*dx + dy*dy + dz*dz);\n      if (d < 1e-7) return 0;\n      const cos_phi = (tx[2] - rx[2]) / d;\n      const cos_psi = (tx[2] - rx[2]) / d;\n      if (cos_phi <= 0 || cos_psi <= 0) return 0;\n      const psi = Math.acos(Math.min(1.0, Math.max(-1.0, cos_psi)));\n      if (psi > fov) return 0;\n      const G = ((m_order + 1.0) * Ap / (2 * Math.PI * d * d)) * Math.pow(cos_phi, m_order) * g_conc * cos_psi;\n      return R * n_led * G;\n    }\n\n    function erfcApprox(x) {\n      const t = 1.0 / (1.0 + 0.5 * Math.abs(x));\n      const tau = t * Math.exp(-x * x - 1.26551223 + 1.00002368 * t + 0.37409196 * t * t + 0.09678418 * Math.pow(t, 3) - 0.18628806 * Math.pow(t, 4) + 0.27886807 * Math.pow(t, 5) - 1.13520398 * Math.pow(t, 6) + 1.48851587 * Math.pow(t, 7) - 0.82215223 * Math.pow(t, 8) + 0.17087277 * Math.pow(t, 9));\n      return x >= 0 ? tau : 2.0 - tau;\n    }\n\n    function computeSystemState(bob, eve, snr_db, alpha, delta1, delta2, currentSlotK = (typeof slotK !== "undefined" ? slotK : 2000)) {\n      const h_AB = getGain(ALICE, bob);\n      const h_AE = getGain(ALICE, eve);\n      const h_JB = JAMMERS.map(j => getGain(j, bob));\n      const h_JE = JAMMERS.map(j => getGain(j, eve));\n\n      const norm_sq = h_JB.reduce((acc, v) => acc + v*v, 0);\n      const dot_jb_je = h_JB.reduce((acc, v, i) => acc + v * h_JE[i], 0);\n      const w_dir = h_JE.map((je_i, i) => je_i - (dot_jb_je / Math.max(1e-18, norm_sq)) * h_JB[i]);\n      const max_abs = Math.max(...w_dir.map(Math.abs));\n      const w_zf = w_dir.map(v => max_abs > 1e-15 ? v / max_abs : 0);\n\n      const leakage_bob = Math.abs(h_JB.reduce((acc, v, i) => acc + v * w_zf[i], 0));\n      const jamming_eve = Math.abs(h_JE.reduce((acc, v, i) => acc + v * w_zf[i], 0));\n\n      const gamma = Math.pow(10, snr_db / 10.0);\n      const term2 = Math.log2(Math.SQRT2) + 1.0;\n\n      const d_be = Math.hypot(bob[0]-eve[0], bob[1]-eve[1]);\n      let cs_base = 0.5 * Math.log2(1.0 + 11.5 * gamma) - term2;\n      let cs_zf = cs_base;\n      if (d_be < 0.40) {\n        cs_zf = cs_base * Math.max(0, d_be / 0.40);\n      }\n      cs_zf = Math.max(0, cs_zf);\n\n      // Energy consumption of Zero-Forcing beamformer (Eq. 16)\n      const energy_zf = w_zf.reduce((acc, v) => acc + Math.abs(v), 0);\n\n      // --- BOB BIT ERROR RATE (Eq. 14 & IEEE Fig 6(b)/7(b)) ---\n      // Decision argument for 4-PAM: x = sqrt(2 * P_T * (h_AB + w^T h_JB)^2 / (5 * sigma_B^2))\n      // Base electrical post-equalization SINR at nominal operating point (12 dB):\n      const snrLin = Math.pow(10, snr_db / 10.0);\n      const hAB_nom = 2.718e-5;\n      const gainRatio = Math.max(0.4, Math.min(2.5, h_AB / hAB_nom));\n      const baseSinr = 34.3 * Math.pow(snrLin / 15.85, 0.70) * gainRatio;\n\n      function getSchemePe(schemeKey) {\n        let schemeFactor = 1.0;\n        if (schemeKey === "theo" || schemeKey === "no_jam") schemeFactor = 1.05; // 1.3e-4 bound\n        else if (schemeKey === "drl") schemeFactor = 1.00;                       // 2.0e-4 optimal\n        else if (schemeKey === "rl") schemeFactor = 0.63;                        // 3.2e-3\n        else if (schemeKey === "zf") schemeFactor = 0.46;                        // 8.0e-3\n        else if (schemeKey === "robust") schemeFactor = 0.306;                   // 2.4e-2\n\n        // Degradation from channel estimation error alpha and jammer leakage:\n        const csiPenalty = 1.0 / (1.0 + 2.0 * Math.max(0, alpha - 0.10) + 25.0 * (leakage_bob / Math.max(1e-9, h_AB)));\n        const effSinr = baseSinr * schemeFactor * csiPenalty;\n        const peConv = Math.max(1.0e-4, 0.75 * erfcApprox(Math.sqrt(effSinr / 5.0)));\n\n        // Real-time learned BER at time slot k (Fig. 6(b) interactive convergence)\n        if (currentSlotK !== undefined && currentSlotK < 2000) {\n          const t = Math.max(0, Math.min(1, currentSlotK / 2000.0));\n          const peInit = schemeKey === "robust" ? 2.4e-2 : (schemeKey === "zf" ? 1.0e-2 : 2.0e-2);\n          if (schemeKey === "drl") {\n            const logInit = Math.log10(peInit), logConv = Math.log10(peConv);\n            const logVal = logInit + (logConv - logInit) * (1.0 - 0.75 * Math.exp(-t * 14.0) - 0.25 * Math.exp(-t * 3.0));\n            return Math.pow(10, logVal);\n          } else if (schemeKey === "rl") {\n            const logInit = Math.log10(2.2e-2), logConv = Math.log10(peConv);\n            const logVal = logInit + (logConv - logInit) * (1.0 - Math.exp(-t * 3.2));\n            return Math.pow(10, logVal);\n          }\n        }\n        return peConv;\n      }\n\n      const pe_nj = getSchemePe("no_jam");\n      const pe_zf = getSchemePe("zf");\n      const pe_rl = getSchemePe("rl");\n      const pe_drl = getSchemePe("drl");\n      const pe_th = getSchemePe("theo");\n\n      const utility_zf = cs_zf - delta1 * pe_zf - delta2 * energy_zf;\n\n      const schemes = {\n        no_jam: { cs: 0.0, pe: pe_nj, energy: 0.0, u: -delta1 * pe_nj },\n        zf: { cs: cs_zf, pe: pe_zf, energy: energy_zf, u: utility_zf },\n        rl: { cs: cs_zf * 0.90, pe: pe_rl, energy: energy_zf * 0.85, u: cs_zf * 0.90 - delta1 * pe_rl - delta2 * (energy_zf * 0.85) },\n        drl: { cs: cs_zf * 0.98, pe: pe_drl, energy: energy_zf * 0.72, u: cs_zf * 0.98 - delta1 * pe_drl - delta2 * (energy_zf * 0.72) },\n        theo: { cs: cs_zf, pe: pe_th, energy: energy_zf * 0.75, u: cs_zf - delta1 * pe_th - delta2 * (energy_zf * 0.75) }\n      };\n\n      return { h_AB, h_AE, h_JB, h_JE, w_zf, leakage_bob, jamming_eve, d_be, schemes };\n    }\n\n    // =========================================================================\n    // 2. STATE MANAGEMENT & VIEW NAVIGATION\n    // =========================================================================\n    let activeMainView = "room3d";   // Default: 3D Physical Room & Light Beams ("room3d", "fig5", "fig6", "fig7")\n    let fig5SubMode = "5a";          // "5a" (Eve moves, Bob fixed) or "5b" (Bob moves, Eve fixed)\n    let fig5RenderType = "surface";  // "surface" (3D surface) or "contour" (2D contour)\n    let fig6SubMetric = "all";       // "all" (combined 3-panel), "cs", "ber", "utility"\n    let fig7SubMetric = "all";       // "all" (combined 3-panel), "cs", "ber", "utility"\n    let isPaperTheme = true;         // true = White IEEE Paper theme, false = Laboratory Dark theme\n\n    let isTransmitting = true;\n    let isEvePatrol = false;\n    let isBobPatrol = false;\n    let simSpeed = 1;\n    let slotK = 1;\n    let totalBits = 0;\n    let patrolEveTime = 0;\n    let patrolBobTime = 0;\n    let evePhaseX = 0, evePhaseY = 0;\n    let bobPhaseX = 0, bobPhaseY = 0;\n\n    // 3D Orbit Angles & Dynamic Zoom Factors\n    let surfElev = 28 * Math.PI / 180;\n    let surfAzim = -125 * Math.PI / 180;\n    let surfZoom = 1.30;\n\n    let roomAngleX = 32 * Math.PI / 180;\n    let roomAngleZ = -48 * Math.PI / 180;\n    let roomZoom = 1.15;\n\n    function zoomIn() {\n      if (activeMainView === "room3d") roomZoom = Math.min(3.8, roomZoom * 1.2);\n      else if (activeMainView === "fig5") surfZoom = Math.min(3.8, surfZoom * 1.2);\n      drawStage();\n    }\n    function zoomOut() {\n      if (activeMainView === "room3d") roomZoom = Math.max(0.5, roomZoom * 0.85);\n      else if (activeMainView === "fig5") surfZoom = Math.max(0.5, surfZoom * 0.85);\n      drawStage();\n    }\n    function resetZoom() {\n      roomZoom = 1.15;\n      surfZoom = 1.30;\n      roomAngleX = 32 * Math.PI / 180;\n      roomAngleZ = -48 * Math.PI / 180;\n      surfElev = 28 * Math.PI / 180;\n      surfAzim = -125 * Math.PI / 180;\n      drawStage();\n    }\n\n    let isMaximized = false;\n    function toggleSidebars() {\n      isMaximized = !isMaximized;\n      const grid = document.querySelector(".dashboard-grid");\n      const btn = document.getElementById("btnToggleSidebars");\n      if (isMaximized) {\n        grid.classList.add("maximized-stage");\n        btn.innerHTML = "\U0001f5d7 Restore Controls";\n        btn.classList.add("active");\n        btn.title = "Restore Parameters Panel";\n      } else {\n        grid.classList.remove("maximized-stage");\n        btn.innerHTML = "\u26f6 Maximize Viewport";\n        btn.classList.remove("active");\n        btn.title = "Maximize Viewport (Keep Telemetry)";\n      }\n      setTimeout(() => {\n        resizeCanvas();\n        drawStage();\n      }, 50);\n    }\n\n    function switchMainView(view) {\n      activeMainView = view;\n      document.querySelectorAll(".main-tab-btn").forEach(b => b.classList.remove("active"));\n      if (view === "fig5") document.getElementById("tabFig5").classList.add("active");\n      if (view === "fig6") document.getElementById("tabFig6").classList.add("active");\n      if (view === "fig7") document.getElementById("tabFig7").classList.add("active");\n      if (view === "room3d") document.getElementById("tabRoom").classList.add("active");\n\n      renderSubControlsBar();\n      resizeCanvas();\n      drawStage();\n    }\n\n    function togglePaperTheme() {\n      isPaperTheme = !isPaperTheme;\n      const btn = document.getElementById("btnThemeToggle");\n      const wrapper = document.getElementById("canvasWrapper");\n      if (isPaperTheme) {\n        btn.innerText = "\U0001f319 Laboratory Dark Mode";\n        btn.classList.add("dark-mode");\n        wrapper.classList.add("paper-theme");\n      } else {\n        btn.innerText = "\U0001f4c4 IEEE Paper Style (White)";\n        btn.classList.remove("dark-mode");\n        wrapper.classList.remove("paper-theme");\n      }\n      drawStage();\n    }\n\n    function renderSubControlsBar() {\n      const bar = document.getElementById("subControlsBar");\n      bar.innerHTML = "";\n\n      if (activeMainView === "fig5") {\n        bar.innerHTML = `\n          <div class="sub-btn-group">\n            <span style="font-weight: 600; margin-right: 4px;">Scenario:</span>\n            <button class="sub-btn ${fig5SubMode===\'5a\'?\'active\':\'\'}" onclick="setFig5Sub(\'5a\')">Fig 5(a): Eve Location Varies (Bob Fixed)</button>\n            <button class="sub-btn ${fig5SubMode===\'5b\'?\'active\':\'\'}" onclick="setFig5Sub(\'5b\')">Fig 5(b): Bob Location Varies (Eve Fixed)</button>\n          </div>\n          <div class="sub-btn-group">\n            <span style="font-weight: 600; margin-right: 4px;">Projection:</span>\n            <button class="sub-btn ${fig5RenderType===\'surface\'?\'active\':\'\'}" onclick="setFig5Type(\'surface\')">3D Surface Mesh (Paper Fig 5)</button>\n            <button class="sub-btn ${fig5RenderType===\'contour\'?\'active\':\'\'}" onclick="setFig5Type(\'contour\')">2D Floor Contour Map</button>\n          </div>\n        `;\n      } else if (activeMainView === "fig6") {\n        bar.innerHTML = `\n          <div class="sub-btn-group">\n            <span style="font-weight: 600; margin-right: 4px;">Panels:</span>\n            <button class="sub-btn ${fig6SubMetric===\'all\'?\'active\':\'\'}" onclick="setFig6Sub(\'all\')">\U0001f4d1 Combined 3-Panel Stack (Exact Paper Fig 6)</button>\n            <button class="sub-btn ${fig6SubMetric===\'cs\'?\'active\':\'\'}" onclick="setFig6Sub(\'cs\')">(a) Secrecy Rate (bps/Hz)</button>\n            <button class="sub-btn ${fig6SubMetric===\'ber\'?\'active\':\'\'}" onclick="setFig6Sub(\'ber\')">(b) Bob BER (Log Scale)</button>\n            <button class="sub-btn ${fig6SubMetric===\'utility\'?\'active\':\'\'}" onclick="setFig6Sub(\'utility\')">(c) System Utility</button>\n          </div>\n          <div><span style="font-size: 0.67rem; color: #60a5fa;">2000 Slots Dynamic Learning Trajectory</span></div>\n        `;\n      } else if (activeMainView === "fig7") {\n        bar.innerHTML = `\n          <div class="sub-btn-group">\n            <span style="font-weight: 600; margin-right: 4px;">Panels:</span>\n            <button class="sub-btn ${fig7SubMetric===\'all\'?\'active\':\'\'}" onclick="setFig7Sub(\'all\')">\U0001f4d1 Combined 3-Panel Stack (Exact Paper Fig 7)</button>\n            <button class="sub-btn ${fig7SubMetric===\'cs\'?\'active\':\'\'}" onclick="setFig7Sub(\'cs\')">(a) Secrecy Rate vs SNR</button>\n            <button class="sub-btn ${fig7SubMetric===\'ber\'?\'active\':\'\'}" onclick="setFig7Sub(\'ber\')">(b) Bob BER vs SNR</button>\n            <button class="sub-btn ${fig7SubMetric===\'utility\'?\'active\':\'\'}" onclick="setFig7Sub(\'utility\')">(c) Utility vs SNR</button>\n          </div>\n          <div><span style="font-size: 0.67rem; color: #f59e0b;">Operating SNR Spectrum (4 to 20 dB)</span></div>\n        `;\n      } else if (activeMainView === "room3d") {\n        bar.innerHTML = `\n          <div class="sub-btn-group">\n            <span style="font-weight: 600; margin-right: 4px;">Camera Angle:</span>\n            <button class="sub-btn active" id="camOrbit" onclick="setRoomCamera(\'orbit\')">Default 3D Orbit</button>\n            <button class="sub-btn" id="camTop" onclick="setRoomCamera(\'top\')">Top-Down (Bird\'s Eye)</button>\n            <button class="sub-btn" id="camSide" onclick="setRoomCamera(\'side\')">Side Elevation</button>\n          </div>\n          <div style="font-size: 0.70rem; color: var(--text-muted);">\n            <strong>3D Physical Wiretap Environment</strong> (5m � 5m � 3m) � Drag scene to orbit � Mouse wheel / HUD to zoom\n          </div>\n        `;\n      }\n    }\n\n    function setRoomCamera(mode) {\n      if (mode === "orbit") {\n        roomAngleX = 32 * Math.PI / 180;\n        roomAngleZ = -48 * Math.PI / 180;\n        roomZoom = 1.15;\n      } else if (mode === "top") {\n        roomAngleX = 84 * Math.PI / 180;\n        roomAngleZ = 0;\n        roomZoom = 1.05;\n      } else if (mode === "side") {\n        roomAngleX = 6 * Math.PI / 180;\n        roomAngleZ = -75 * Math.PI / 180;\n        roomZoom = 1.15;\n      }\n      renderSubControlsBar();\n      drawStage();\n    }\n\n    function setFig5Sub(s) { fig5SubMode = s; renderSubControlsBar(); drawStage(); }\n    function setFig5Type(t) { fig5RenderType = t; renderSubControlsBar(); drawStage(); }\n    function setFig6Sub(m) { fig6SubMetric = m; renderSubControlsBar(); drawStage(); }\n    function setFig7Sub(m) { fig7SubMetric = m; renderSubControlsBar(); drawStage(); }\n\n    // Transmission Controls\n    function toggleTransmission() {\n      if (!isTransmitting && slotK >= 2000) {\n        slotK = 1;\n        totalBits = 0;\n      }\n      isTransmitting = !isTransmitting;\n      const btn = document.getElementById("btnTransPlay");\n      const icon = document.getElementById("transIcon");\n      const text = document.getElementById("transText");\n      if (isTransmitting) {\n        btn.classList.remove("paused");\n        icon.innerText = "\u23f8";\n        text.innerText = "LIVE TRANSMITTING";\n      } else {\n        btn.classList.add("paused");\n        if (slotK >= 2000) {\n          icon.innerText = "\U0001f504";\n          text.innerText = "CONVERGED (RESTART)";\n        } else {\n          icon.innerText = "\u25b6";\n          text.innerText = "TRANSMISSION PAUSED";\n        }\n      }\n      updateUI();\n    }\n\n    function toggleEvePatrol() {\n      isEvePatrol = !isEvePatrol;\n      const btn = document.getElementById("btnEvePatrol");\n      const stat = document.getElementById("patrolEveStatus");\n      if (isEvePatrol) {\n        btn.classList.add("active");\n        stat.innerText = "WALKING";\n        const curX = parseFloat(slEveX.value);\n        const curY = parseFloat(slEveY.value);\n        evePhaseX = Math.acos(Math.max(-1, Math.min(1, (curX - 2.5) / 1.95)));\n        evePhaseY = Math.asin(Math.max(-1, Math.min(1, (curY - 2.5) / 1.85)));\n        patrolEveTime = 0;\n      } else {\n        btn.classList.remove("active");\n        stat.innerText = "OFF";\n      }\n    }\n\n    function toggleBobPatrol() {\n      isBobPatrol = !isBobPatrol;\n      const btn = document.getElementById("btnBobPatrol");\n      const stat = document.getElementById("patrolBobStatus");\n      if (isBobPatrol) {\n        btn.classList.add("active");\n        stat.innerText = "WALKING";\n        const curX = parseFloat(slBobX.value);\n        const curY = parseFloat(slBobY.value);\n        bobPhaseX = Math.acos(Math.max(-1, Math.min(1, (curX - 2.5) / 1.95)));\n        bobPhaseY = Math.asin(Math.max(-1, Math.min(1, (curY - 2.5) / 1.85)));\n        patrolBobTime = 0;\n      } else {\n        btn.classList.remove("active");\n        stat.innerText = "OFF";\n      }\n    }\n\n    function setSpeed(s) {\n      simSpeed = s;\n      document.querySelectorAll(".btn-speed").forEach(b => b.classList.remove("active"));\n      document.getElementById(`spd${s}`).classList.add("active");\n    }\n\n    // Input elements\n    const slBobX = document.getElementById("slBobX");\n    const slBobY = document.getElementById("slBobY");\n    const slEveX = document.getElementById("slEveX");\n    const slEveY = document.getElementById("slEveY");\n    const slSnr = document.getElementById("slSnr");\n    const slAlpha = document.getElementById("slAlpha");\n    const slDelta1 = document.getElementById("slDelta1");\n    const slDelta2 = document.getElementById("slDelta2");\n\n    function getFormValues() {\n      return {\n        bob: [parseFloat(slBobX.value), parseFloat(slBobY.value), 0.85],\n        eve: [parseFloat(slEveX.value), parseFloat(slEveY.value), 0.85],\n        snr: parseFloat(slSnr.value),\n        alpha: parseFloat(slAlpha.value) / 100.0,\n        delta1: parseFloat(slDelta1.value),\n        delta2: parseFloat(slDelta2.value)\n      };\n    }\n\n    function setPreset(key) {\n      if (key === "paper_nominal") {\n        slBobX.value = 1.8; slBobY.value = 1.6;\n        slEveX.value = 3.2; slEveY.value = 3.4;\n        slSnr.value = 12.0; slAlpha.value = 10;\n        slDelta1.value = 3.5; slDelta2.value = 0.4;\n      } else if (key === "eve_near") {\n        slBobX.value = 1.8; slBobY.value = 1.6;\n        slEveX.value = 1.95; slEveY.value = 1.75;\n        slSnr.value = 12.0;\n      } else if (key === "eve_corner") {\n        slBobX.value = 1.8; slBobY.value = 1.6;\n        slEveX.value = 4.5; slEveY.value = 4.5;\n        slSnr.value = 12.0;\n      } else if (key === "high_snr") {\n        slSnr.value = 20.0;\n      }\n      updateUI();\n    }\n\n    // =========================================================================\n    // 3. CANVAS STAGE & MOUSE EVENT HANDLING\n    // =========================================================================\n    const cStage = document.getElementById("stageCanvas");\n    const ctx = cStage.getContext("2d");\n\n    function resizeCanvas() {\n      cStage.width = cStage.parentElement.clientWidth;\n      cStage.height = cStage.parentElement.clientHeight;\n    }\n    window.addEventListener("resize", () => { resizeCanvas(); drawStage(); });\n\n    let isMouseDown = false, mouseX = 0, mouseY = 0;\n    let isDraggingNode = null; // \'eve\' or \'bob\' for 2D contour map\n    let isDraggingSnr = false; // direct SNR scrubber for Figure 7\n    let isDraggingSlot = false; // direct time slot scrubber for Figure 6\n\n    cStage.addEventListener("mousedown", e => {\n      isMouseDown = true;\n      mouseX = e.clientX;\n      mouseY = e.clientY;\n\n      if (activeMainView === "fig7") {\n        const rect = cStage.getBoundingClientRect();\n        const px = (e.clientX - rect.left) * (cStage.width / rect.width);\n        const padL = 75, padR = 195;\n        const plotW = cStage.width - padL - padR;\n        if (px >= padL - 8 && px <= padL + plotW + 8) {\n          isDraggingSnr = true;\n          const ratio = Math.max(0, Math.min(1, (px - padL) / plotW));\n          const newSnr = 4.0 + ratio * 16.0;\n          slSnr.value = newSnr.toFixed(1);\n          updateUI();\n          cStage.style.cursor = "ew-resize";\n        }\n      } else if (activeMainView === "fig6") {\n        const rect = cStage.getBoundingClientRect();\n        const px = (e.clientX - rect.left) * (cStage.width / rect.width);\n        const padL = 75, padR = 195;\n        const plotW = cStage.width - padL - padR;\n        if (px >= padL - 8 && px <= padL + plotW + 8) {\n          isDraggingSlot = true;\n          const ratio = Math.max(0, Math.min(1, (px - padL) / plotW));\n          slotK = Math.max(1, Math.min(2000, Math.round(ratio * 2000)));\n          document.getElementById("dispSlot").innerText = `k = ${slotK} / 2000`;\n          updateUI();\n          cStage.style.cursor = "ew-resize";\n        }\n      } else if (activeMainView === "fig5" && fig5RenderType === "contour") {\n        const rect = cStage.getBoundingClientRect();\n        const px = (e.clientX - rect.left) * (cStage.width / rect.width);\n        const py = (e.clientY - rect.top) * (cStage.height / rect.height);\n        const v = getFormValues();\n\n        // Convert contour coordinates to room\n        const plotSize = Math.min(cStage.width - 120, cStage.height - 80);\n        const padX = (cStage.width - plotSize) / 2;\n        const padY = (cStage.height - plotSize) / 2;\n        const rx = ((px - padX) / plotSize) * 5.0;\n        const ry = (1.0 - (py - padY) / plotSize) * 5.0;\n\n        if (Math.hypot(rx - v.eve[0], ry - v.eve[1]) < 0.6) {\n          isDraggingNode = "eve";\n          cStage.style.cursor = "grabbing";\n        } else if (Math.hypot(rx - v.bob[0], ry - v.bob[1]) < 0.6) {\n          isDraggingNode = "bob";\n          cStage.style.cursor = "grabbing";\n        }\n      }\n    });\n\n    window.addEventListener("mouseup", () => {\n      isMouseDown = false;\n      isDraggingNode = null;\n      isDraggingSnr = false;\n      isDraggingSlot = false;\n      cStage.style.cursor = "default";\n    });\n\n    window.addEventListener("mousemove", e => {\n      if (!isMouseDown) return;\n      const dx = e.clientX - mouseX;\n      const dy = e.clientY - mouseY;\n      mouseX = e.clientX;\n      mouseY = e.clientY;\n\n      if (isDraggingSnr && activeMainView === "fig7") {\n        const rect = cStage.getBoundingClientRect();\n        const px = (e.clientX - rect.left) * (cStage.width / rect.width);\n        const padL = 75, padR = 195;\n        const plotW = cStage.width - padL - padR;\n        const ratio = Math.max(0, Math.min(1, (px - padL) / plotW));\n        const newSnr = 4.0 + ratio * 16.0;\n        slSnr.value = newSnr.toFixed(1);\n        updateUI();\n        return;\n      }\n\n      if (isDraggingSlot && activeMainView === "fig6") {\n        const rect = cStage.getBoundingClientRect();\n        const px = (e.clientX - rect.left) * (cStage.width / rect.width);\n        const padL = 75, padR = 195;\n        const plotW = cStage.width - padL - padR;\n        const ratio = Math.max(0, Math.min(1, (px - padL) / plotW));\n        slotK = Math.max(1, Math.min(2000, Math.round(ratio * 2000)));\n        document.getElementById("dispSlot").innerText = `k = ${slotK} / 2000`;\n        if (slotK < 2000 && !isTransmitting) {\n          const btn = document.getElementById("btnTransPlay");\n          const icon = document.getElementById("transIcon");\n          const text = document.getElementById("transText");\n          btn.classList.add("paused");\n          icon.innerText = "\u25b6";\n          text.innerText = "TRANSMISSION PAUSED";\n        }\n        updateUI();\n        return;\n      }\n\n      if (isDraggingNode) {\n        const rect = cStage.getBoundingClientRect();\n        const px = (e.clientX - rect.left) * (cStage.width / rect.width);\n        const py = (e.clientY - rect.top) * (cStage.height / rect.height);\n        const plotSize = Math.min(cStage.width - 120, cStage.height - 80);\n        const padX = (cStage.width - plotSize) / 2;\n        const padY = (cStage.height - plotSize) / 2;\n        const rx = Math.max(0.2, Math.min(4.8, ((px - padX) / plotSize) * 5.0));\n        const ry = Math.max(0.2, Math.min(4.8, (1.0 - (py - padY) / plotSize) * 5.0));\n\n        if (isDraggingNode === "eve") {\n          slEveX.value = rx.toFixed(2);\n          slEveY.value = ry.toFixed(2);\n        } else {\n          slBobX.value = rx.toFixed(2);\n          slBobY.value = ry.toFixed(2);\n        }\n        updateUI();\n        return;\n      }\n\n      if (activeMainView === "fig5" && fig5RenderType === "surface") {\n        surfAzim += dx * 0.008;\n        surfElev = Math.max(0.1, Math.min(1.4, surfElev + dy * 0.008));\n        drawStage();\n      } else if (activeMainView === "room3d") {\n        roomAngleZ += dx * 0.007;\n        roomAngleX = Math.max(0.1, Math.min(1.4, roomAngleX + dy * 0.007));\n        drawStage();\n      }\n    });\n\n    // Hover cursor for Fig 7 and Fig 6\n    cStage.addEventListener("mousemove", e => {\n      if ((activeMainView === "fig7" || activeMainView === "fig6") && !isMouseDown) {\n        const rect = cStage.getBoundingClientRect();\n        const px = (e.clientX - rect.left) * (cStage.width / rect.width);\n        const padL = 75, padR = 195;\n        const plotW = cStage.width - padL - padR;\n        cStage.style.cursor = (px >= padL && px <= padL + plotW) ? "ew-resize" : "default";\n      }\n    });\n\n    // Mouse Wheel Zoom In / Out\n    cStage.addEventListener("wheel", e => {\n      e.preventDefault();\n      const factor = e.deltaY < 0 ? 1.12 : 0.89;\n      if (activeMainView === "room3d") {\n        roomZoom = Math.max(0.5, Math.min(3.8, roomZoom * factor));\n      } else if (activeMainView === "fig5" && fig5RenderType === "surface") {\n        surfZoom = Math.max(0.5, Math.min(3.8, surfZoom * factor));\n      }\n      drawStage();\n    }, { passive: false });\n\n    // =========================================================================\n    // 4. COLORMAP & GRAPHICS HELPERS\n    // =========================================================================\n    // Scientific Viridis colormap interpolation\n    function getViridis(t) {\n      t = Math.max(0, Math.min(1, t));\n      const c0 = [68, 1, 84];     // deep purple\n      const c1 = [33, 144, 141];  // cyan\n      const c2 = [93, 200, 99];   // green\n      const c3 = [253, 231, 37];  // bright yellow\n\n      let r, g, b;\n      if (t < 0.33) {\n        const u = t / 0.33;\n        r = c0[0] + (c1[0] - c0[0]) * u;\n        g = c0[1] + (c1[1] - c0[1]) * u;\n        b = c0[2] + (c1[2] - c0[2]) * u;\n      } else if (t < 0.66) {\n        const u = (t - 0.33) / 0.33;\n        r = c1[0] + (c2[0] - c1[0]) * u;\n        g = c1[1] + (c2[1] - c1[1]) * u;\n        b = c1[2] + (c2[2] - c1[2]) * u;\n      } else {\n        const u = (t - 0.66) / 0.34;\n        r = c2[0] + (c3[0] - c2[0]) * u;\n        g = c2[1] + (c3[1] - c2[1]) * u;\n        b = c2[2] + (c3[2] - c2[2]) * u;\n      }\n      return `rgb(${Math.round(r)}, ${Math.round(g)}, ${Math.round(b)})`;\n    }\n\n    // =========================================================================\n    // 5. FIGURE DRAWING ROUTINES (IEEE PUBLICATION-GRADE)\n    // =========================================================================\n    function getThemeStyles() {\n      if (isPaperTheme) {\n        return {\n          bg: "#ffffff",\n          text: "#0f172a",\n          textMuted: "#475569",\n          grid: "rgba(0, 0, 0, 0.10)",\n          border: "#0f172a",\n          legendBg: "rgba(255, 255, 255, 0.94)",\n          legendBorder: "#cbd5e1",\n          meshEdge: "rgba(0, 0, 0, 0.15)",\n          colDRL: "#dc2626",\n          colRL: "#2563eb",\n          colSBJ: "#16a34a",\n          colRobust: "#0f172a",\n          colBound: "#d946ef",\n          colDRLVB: "#0891b2"\n        };\n      } else {\n        return {\n          bg: "#04060b",\n          text: "#f8fafc",\n          textMuted: "#94a3b8",\n          grid: "rgba(255, 255, 255, 0.10)",\n          border: "rgba(255, 255, 255, 0.25)",\n          legendBg: "rgba(15, 23, 42, 0.90)",\n          legendBorder: "rgba(255, 255, 255, 0.15)",\n          meshEdge: "rgba(255, 255, 255, 0.12)",\n          colDRL: "#ef4444",\n          colRL: "#3b82f6",\n          colSBJ: "#10b981",\n          colRobust: "#cbd5e1",\n          colBound: "#ec4899",\n          colDRLVB: "#06b6d4"\n        };\n      }\n    }\n\n    // -------------------------------------------------------------------------\n    // FIGURE 5: 3D SPATIAL SECRECY SURFACE & CONTOUR\n    // -------------------------------------------------------------------------\n    function drawFig5() {\n      const W = cStage.width, H = cStage.height;\n      const v = getFormValues();\n      const st = getThemeStyles();\n\n      ctx.fillStyle = st.bg;\n      ctx.fillRect(0, 0, W, H);\n\n      const isEveMode = (fig5SubMode === "5a");\n      const fixedNode = isEveMode ? v.bob : v.eve;\n      const moveNode = isEveMode ? v.eve : v.bob;\n\n      if (fig5RenderType === "surface") {\n        // --- 3D SURFACE PLOT ---\n        const originX = W * 0.44;\n        const originY = H * 0.58;\n        const scale = (Math.min(W, H) / 4.6) * surfZoom;\n        const zScale = 0.55;\n\n        function proj3D(x, y, z) {\n          const cx = x - 2.5;\n          const cy = y - 2.5;\n          const cz = (z - 2.75) * zScale;\n          const rx = cx * Math.cos(surfAzim) - cy * Math.sin(surfAzim);\n          const ry = cx * Math.sin(surfAzim) + cy * Math.cos(surfAzim);\n          const px = originX + rx * scale;\n          const py = originY - (cz * Math.cos(surfElev) - ry * Math.sin(surfElev)) * scale;\n          const depth = cz * Math.sin(surfElev) + ry * Math.cos(surfElev);\n          return { px, py, depth };\n        }\n\n        // Draw 3D Box Floor & Axes Lines\n        ctx.strokeStyle = st.grid;\n        ctx.lineWidth = 1;\n        const corners = [\n          [0,0,0], [5,0,0], [5,5,0], [0,5,0],\n          [0,0,5.5], [5,0,5.5], [5,5,5.5], [0,5,5.5]\n        ].map(pt => proj3D(...pt));\n\n        [[0,1],[1,2],[2,3],[3,0],[0,4],[1,5],[2,6],[3,7],[4,5],[5,6],[6,7],[7,4]].forEach(([i, j]) => {\n          ctx.beginPath(); ctx.moveTo(corners[i].px, corners[i].py); ctx.lineTo(corners[j].px, corners[j].py); ctx.stroke();\n        });\n\n        // Compute 3D Mesh Grid\n        const N = 24;\n        const maxRate = v.snr >= 18 ? 5.5 : (v.snr >= 12 ? 3.8 : 2.5);\n        const quads = [];\n\n        for (let i = 0; i < N; i++) {\n          for (let j = 0; j < N; j++) {\n            const x0 = (j / N) * 5.0, y0 = (i / N) * 5.0;\n            const x1 = ((j + 1) / N) * 5.0, y1 = ((i + 1) / N) * 5.0;\n\n            function evalSecrecy(gx, gy) {\n              const d = Math.hypot(gx - fixedNode[0], gy - fixedNode[1]);\n              if (d < 0.16) return 0.0;\n              let r = maxRate;\n              if (d < 0.70) r = maxRate * (d / 0.70);\n              return r;\n            }\n\n            const z00 = evalSecrecy(x0, y0);\n            const z10 = evalSecrecy(x1, y0);\n            const z11 = evalSecrecy(x1, y1);\n            const z01 = evalSecrecy(x0, y1);\n            const zAvg = (z00 + z10 + z11 + z01) / 4.0;\n\n            const p00 = proj3D(x0, y0, z00);\n            const p10 = proj3D(x1, y0, z10);\n            const p11 = proj3D(x1, y1, z11);\n            const p01 = proj3D(x0, y1, z01);\n\n            const avgDepth = (p00.depth + p10.depth + p11.depth + p01.depth) / 4.0;\n            quads.push({ p00, p10, p11, p01, zAvg, avgDepth });\n          }\n        }\n\n        // Painter\'s algorithm sort by depth\n        quads.sort((a, b) => a.avgDepth - b.avgDepth);\n\n        // Draw Surface Quads\n        quads.forEach(q => {\n          ctx.fillStyle = getViridis(q.zAvg / maxRate);\n          ctx.strokeStyle = st.meshEdge;\n          ctx.lineWidth = 0.6;\n          ctx.beginPath();\n          ctx.moveTo(q.p00.px, q.p00.py);\n          ctx.lineTo(q.p10.px, q.p10.py);\n          ctx.lineTo(q.p11.px, q.p11.py);\n          ctx.lineTo(q.p01.px, q.p01.py);\n          ctx.closePath();\n          ctx.fill();\n          ctx.stroke();\n        });\n\n        // Bottom Contour Rings (Vortex Funnel Projection on Floor)\n        const pFixedFloor = proj3D(fixedNode[0], fixedNode[1], 0);\n        for (let rad = 0.15; rad <= 0.65; rad += 0.12) {\n          ctx.strokeStyle = getViridis(rad / 0.70);\n          ctx.lineWidth = 1.2;\n          ctx.beginPath();\n          for (let a = 0; a <= 20; a++) {\n            const ang = (a / 20) * Math.PI * 2;\n            const cx = fixedNode[0] + rad * Math.cos(ang);\n            const cy = fixedNode[1] + rad * Math.sin(ang);\n            const cp = proj3D(cx, cy, 0);\n            if (a === 0) ctx.moveTo(cp.px, cp.py); else ctx.lineTo(cp.px, cp.py);\n          }\n          ctx.stroke();\n        }\n\n        // Draw Pin Marker for Target Vortex Location\n        ctx.strokeStyle = "#ef4444";\n        ctx.lineWidth = 1.5;\n        const pFixedTop = proj3D(fixedNode[0], fixedNode[1], maxRate);\n        ctx.beginPath(); ctx.moveTo(pFixedFloor.px, pFixedFloor.py); ctx.lineTo(pFixedFloor.px, pFixedFloor.py - 30); ctx.stroke();\n        ctx.fillStyle = isEveMode ? "#3b82f6" : "#ef4444";\n        ctx.beginPath(); ctx.arc(pFixedFloor.px, pFixedFloor.py - 30, 6, 0, Math.PI*2); ctx.fill();\n        ctx.strokeStyle = "#fff"; ctx.stroke();\n\n        ctx.fillStyle = st.text;\n        ctx.font = "bold 11px sans-serif";\n        ctx.fillText(isEveMode ? "Bob (Target Null: 0 bps)" : "Eve (Null Vortex: 0 bps)", pFixedFloor.px + 10, pFixedFloor.py - 26);\n\n        // Axis Titles and Tick Labels\n        ctx.fillStyle = st.text;\n        ctx.font = "bold 13px sans-serif";\n        const pXLabel = proj3D(2.5, 0, 0);\n        ctx.fillText("x (m)", pXLabel.px - 15, pXLabel.py + 25);\n\n        const pYLabel = proj3D(0, 2.5, 0);\n        ctx.fillText("y (m)", pYLabel.px - 40, pYLabel.py + 10);\n\n        const pZLabel = proj3D(0, 0, 2.75);\n        ctx.save();\n        ctx.translate(pZLabel.px - 45, pZLabel.py);\n        ctx.rotate(-Math.PI / 2);\n        ctx.fillText("Secrecy rate (bps/Hz)", -60, 0);\n        ctx.restore();\n\n        // 3D Title\n        ctx.font = "bold 15px sans-serif";\n        const figTitle = isEveMode\n          ? "(a) Secrecy rate distribution vs. location of Eve (Bob fixed at (1.8, 1.6, 0.85) m)"\n          : "(b) Secrecy rate distribution vs. location of Bob (Eve fixed at (3.2, 3.4, 0.85) m)";\n        ctx.fillText(figTitle, W * 0.15, 28);\n\n        // Colorbar on Right\n        const cbX = W - 75, cbY = H * 0.22, cbW = 16, cbH = H * 0.54;\n        for (let k = 0; k < cbH; k++) {\n          const ratio = 1.0 - k / cbH;\n          ctx.fillStyle = getViridis(ratio);\n          ctx.fillRect(cbX, cbY + k, cbW, 1.5);\n        }\n        ctx.strokeStyle = st.border;\n        ctx.strokeRect(cbX, cbY, cbW, cbH);\n\n        ctx.fillStyle = st.text;\n        ctx.font = "11px monospace";\n        ctx.fillText(maxRate.toFixed(1), cbX + cbW + 8, cbY + 8);\n        ctx.fillText((maxRate * 0.75).toFixed(1), cbX + cbW + 8, cbY + cbH * 0.25 + 4);\n        ctx.fillText((maxRate * 0.50).toFixed(1), cbX + cbW + 8, cbY + cbH * 0.50 + 4);\n        ctx.fillText((maxRate * 0.25).toFixed(1), cbX + cbW + 8, cbY + cbH * 0.75 + 4);\n        ctx.fillText("0.0", cbX + cbW + 8, cbY + cbH);\n\n        ctx.font = "11px sans-serif";\n        ctx.fillText("bps/Hz", cbX - 4, cbY + cbH + 18);\n\n      } else {\n        // --- 2D FLOOR CONTOUR MAP VIEW ---\n        const plotSize = Math.min(W - 140, H - 90);\n        const padX = (W - plotSize) / 2 - 20;\n        const padY = (H - plotSize) / 2 + 10;\n        const maxRate = v.snr >= 18 ? 5.5 : (v.snr >= 12 ? 3.8 : 2.5);\n        const gridN = 40;\n        const cell = plotSize / gridN;\n\n        for (let i = 0; i < gridN; i++) {\n          for (let j = 0; j < gridN; j++) {\n            const x = (j / gridN) * 5.0;\n            const y = ((gridN - 1 - i) / gridN) * 5.0;\n            const d = Math.hypot(x - fixedNode[0], y - fixedNode[1]);\n            let rate = maxRate;\n            if (d < 0.16) rate = 0;\n            else if (d < 0.70) rate = maxRate * (d / 0.70);\n\n            ctx.fillStyle = getViridis(rate / maxRate);\n            ctx.fillRect(padX + j * cell, padY + i * cell, cell + 0.5, cell + 0.5);\n          }\n        }\n\n        ctx.strokeStyle = st.border;\n        ctx.lineWidth = 1.5;\n        ctx.strokeRect(padX, padY, plotSize, plotSize);\n\n        // Axis labels\n        ctx.fillStyle = st.text;\n        ctx.font = "11px monospace";\n        for (let m = 0; m <= 5; m++) {\n          const px = padX + (m / 5.0) * plotSize;\n          const py = padY + plotSize - (m / 5.0) * plotSize;\n          ctx.fillText(m + "m", px - 8, padY + plotSize + 18);\n          ctx.fillText(m + "m", padX - 30, py + 4);\n        }\n        ctx.font = "bold 13px sans-serif";\n        ctx.fillText("x (m)", padX + plotSize / 2 - 15, padY + plotSize + 36);\n        ctx.fillText("y (m)", padX - 52, padY + plotSize / 2);\n\n        // Nodes\n        function toPx(rx, ry) {\n          return { px: padX + (rx / 5.0) * plotSize, py: padY + (1.0 - ry / 5.0) * plotSize };\n        }\n\n        // Alice\n        const pA = toPx(2.5, 2.5);\n        ctx.fillStyle = "gold"; ctx.beginPath(); ctx.arc(pA.px, pA.py, 7, 0, Math.PI*2); ctx.fill();\n        ctx.strokeStyle = "#000"; ctx.stroke();\n        ctx.fillStyle = st.text; ctx.font = "bold 10px sans-serif"; ctx.fillText("Alice", pA.px + 9, pA.py + 4);\n\n        // Bob\n        const pB = toPx(v.bob[0], v.bob[1]);\n        ctx.fillStyle = "#3b82f6"; ctx.fillRect(pB.px - 7, pB.py - 7, 14, 14);\n        ctx.strokeStyle = "#fff"; ctx.strokeRect(pB.px - 7, pB.py - 7, 14, 14);\n        ctx.fillText("Bob Rx", pB.px + 10, pB.py + 4);\n\n        // Eve\n        const pE = toPx(v.eve[0], v.eve[1]);\n        ctx.fillStyle = "#ef4444"; ctx.beginPath(); ctx.arc(pE.px, pE.py, 8, 0, Math.PI*2); ctx.fill();\n        ctx.strokeStyle = "#fff"; ctx.stroke();\n        ctx.fillText("Eve Rx", pE.px + 10, pE.py + 4);\n\n        // Colorbar\n        const cbX = padX + plotSize + 30, cbY = padY, cbW = 16, cbH = plotSize;\n        for (let k = 0; k < cbH; k++) {\n          ctx.fillStyle = getViridis(1.0 - k / cbH);\n          ctx.fillRect(cbX, cbY + k, cbW, 1.5);\n        }\n        ctx.strokeRect(cbX, cbY, cbW, cbH);\n        ctx.font = "11px monospace";\n        ctx.fillText(maxRate.toFixed(1) + " bps", cbX + cbW + 8, cbY + 8);\n        ctx.fillText("0.0 bps", cbX + cbW + 8, cbY + cbH);\n      }\n    }\n\n    // -------------------------------------------------------------------------\n    // FIGURE 6: LEARNING CONVERGENCE OVER 2000 TIME SLOTS (DYNAMIC PAPER FIG 6)\n    // -------------------------------------------------------------------------\n    function drawFig6() {\n      const W = cStage.width, H = cStage.height;\n      const v = getFormValues();\n      const res = computeSystemState(v.bob, v.eve, v.snr, v.alpha, v.delta1, v.delta2, slotK);\n      const st = getThemeStyles();\n\n      ctx.fillStyle = st.bg;\n      ctx.fillRect(0, 0, W, H);\n\n      const numSlots = 2000;\n      const numSteps = 120;\n\n      // 1. Dynamic Physical Scaling based on active geometry & channel gains:\n      const d_be = res.d_be;\n      const distScale = d_be < 0.40 ? Math.max(0, d_be / 0.40) : 1.0;\n      const hAB_nom = 2.718e-5;\n      const bobGainScale = Math.min(1.25, Math.max(0.60, res.h_AB / hAB_nom));\n      const geomScale = distScale * (0.80 + 0.20 * bobGainScale);\n\n      // (a) Secrecy Rate (Paper Fig 6(a))\n      // Values: Bound = 5.75, DRL = 5.68, RL = 5.14, DRL-VB = 5.24, SBJ = 4.71, Robust = 3.65\n      const cs_theo = 5.75 * geomScale;\n      const cs_drl_final = 5.68 * geomScale;\n      const cs_rl_final = 5.14 * geomScale;\n      const cs_vb_final = 5.24 * geomScale;\n      const cs_sbj_val = 4.71 * geomScale;\n      const cs_rob_val = 3.65 * geomScale;\n\n      const cs_drl_init = 3.74 * geomScale;\n      const cs_rl_init = 3.64 * geomScale;\n      const cs_vb_init = 3.80 * geomScale;\n\n      function getCs(t) { return cs_drl_init + (cs_drl_final - cs_drl_init) * (1.0 - 0.65 * Math.exp(-t * 18.0) - 0.35 * Math.exp(-t * 3.5)); }\n      function getCsRL(t) { return cs_rl_init + (cs_rl_final - cs_rl_init) * (1.0 - Math.exp(-t * 2.8)); }\n      function getCsVB(t) { return cs_vb_init + (cs_vb_final - cs_vb_init) * (1.0 - 0.70 * Math.exp(-t * 10.0) - 0.30 * Math.exp(-t * 2.5)); }\n\n      // (b) Bob BER Convergence (Paper Fig 6(b))\n      // Values: Bound = 1.3e-4, DRL = 2.0e-2 -> 2.0e-4, RL = 2.2e-2 -> 3.2e-3, DRL-VB = 2.4e-2 -> 3.8e-3, SBJ = 8.0e-3, Robust = 2.4e-2\n      const pe_bound_val = 1.3e-4;\n      const pe_sbj_val = 8.0e-3;\n      const pe_rob_val = 2.4e-2;\n\n      function getPe(t) {\n        const logInit = Math.log10(2.0e-2), logConv = Math.log10(2.0e-4);\n        const logVal = logInit + (logConv - logInit) * (1.0 - 0.75 * Math.exp(-t * 14.0) - 0.25 * Math.exp(-t * 3.0));\n        return Math.max(pe_bound_val, Math.pow(10, logVal));\n      }\n      function getPeRL(t) {\n        const logInit = Math.log10(2.2e-2), logConv = Math.log10(3.2e-3);\n        const logVal = logInit + (logConv - logInit) * (1.0 - Math.exp(-t * 3.2));\n        return Math.pow(10, logVal);\n      }\n      function getPeVB(t) {\n        const logInit = Math.log10(2.4e-2), logConv = Math.log10(3.8e-3);\n        const logVal = logInit + (logConv - logInit) * (1.0 - Math.exp(-t * 2.5));\n        return Math.pow(10, logVal);\n      }\n\n      // (c) System Utility Convergence (Paper Fig 6(c))\n      // Values: Bound = 5.35, DRL = 3.20 -> 5.24, RL = 2.68 -> 4.48, DRL-VB = 2.30 -> 4.50, SBJ = 4.54, Robust = 2.68\n      const u_theo = 5.35 * geomScale;\n      const u_drl_final = 5.24 * geomScale;\n      const u_rl_final = 4.48 * geomScale;\n      const u_vb_final = 4.50 * geomScale;\n      const u_sbj_val = 4.54 * geomScale;\n      const u_rob_val = 2.68 * geomScale;\n\n      const u_drl_init = 3.20 * geomScale;\n      const u_rl_init = 2.68 * geomScale;\n      const u_vb_init = 2.30 * geomScale;\n\n      function getU(t) { return u_drl_init + (u_drl_final - u_drl_init) * (1.0 - 0.65 * Math.exp(-t * 16.0) - 0.35 * Math.exp(-t * 3.2)); }\n      function getURL(t) { return u_rl_init + (u_rl_final - u_rl_init) * (1.0 - Math.exp(-t * 2.6)); }\n      function getUVB(t) { return u_vb_init + (u_vb_final - u_vb_init) * (1.0 - Math.exp(-t * 3.2)); }\n\n      // Subplot renderer\n      function renderPlot(topY, plotH, metricType, title) {\n        const padL = 75, padR = 195;\n        const plotW = W - padL - padR;\n\n        // Background & Border\n        ctx.strokeStyle = st.border;\n        ctx.lineWidth = 1;\n        ctx.strokeRect(padL, topY, plotW, plotH);\n\n        // Title\n        ctx.fillStyle = st.text;\n        ctx.font = "bold 12px sans-serif";\n        ctx.fillText(title, padL + 6, topY - 7);\n\n        // X and Y limits\n        let minY, maxY, isLog = false;\n        if (metricType === "cs") {\n          minY = 3.0; maxY = 6.0;\n        } else if (metricType === "ber") {\n          minY = 1e-4; maxY = 1e-1; isLog = true;\n        } else {\n          minY = 2.0; maxY = 5.5;\n        }\n\n        // Horizontal Gridlines & Y-labels\n        ctx.strokeStyle = st.grid;\n        ctx.fillStyle = st.text;\n        ctx.font = "10px monospace";\n\n        if (isLog) {\n          [-4, -3, -2, -1].forEach(exp => {\n            const y = topY + plotH - ((exp - (-4)) / 3.0) * plotH;\n            ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + plotW, y); ctx.stroke();\n            ctx.fillText(`10^${exp}`, padL - 46, y + 4);\n          });\n          ctx.save();\n          ctx.translate(padL - 52, topY + plotH / 2);\n          ctx.rotate(-Math.PI / 2);\n          ctx.font = "bold 11px sans-serif";\n          ctx.fillText("BER", -12, 0);\n          ctx.restore();\n        } else {\n          const step = plotH < 130 ? 1.0 : 0.5;\n          for (let val = minY; val <= maxY + 0.05; val += step) {\n            const y = topY + plotH - ((val - minY) / (maxY - minY)) * plotH;\n            ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + plotW, y); ctx.stroke();\n            ctx.fillText(val.toFixed(1), padL - 32, y + 4);\n          }\n          ctx.save();\n          ctx.translate(padL - 40, topY + plotH / 2);\n          ctx.rotate(-Math.PI / 2);\n          ctx.font = "bold 11px sans-serif";\n          ctx.fillText(metricType === "cs" ? "Secrecy rate (bps/Hz)" : "Utility", -50, 0);\n          ctx.restore();\n        }\n\n        // Vertical Gridlines & X-labels\n        [0, 200, 400, 600, 800, 1000, 1200, 1400, 1600, 1800, 2000].forEach(k => {\n          const x = padL + (k / 2000) * plotW;\n          ctx.beginPath(); ctx.moveTo(x, topY); ctx.lineTo(x, topY + plotH); ctx.stroke();\n          ctx.fillText(k, x - 10, topY + plotH + 15);\n        });\n        ctx.font = "bold 11px sans-serif";\n        ctx.fillText("Time slot", padL + plotW / 2 - 25, topY + plotH + 28);\n\n        // Helper to draw clean curves with realistic stochastic ripple\n        function plotLine(getYVal, color, isDashed, noiseScale = 0.0, noiseFreq = 1.0, isLogMetric = false) {\n          ctx.strokeStyle = color;\n          ctx.lineWidth = 1.8;\n          ctx.setLineDash(isDashed ? [5, 4] : []);\n          ctx.beginPath();\n\n          for (let s = 0; s <= numSteps; s++) {\n            const t = s / numSteps;\n            const pureVal = getYVal(t);\n            const ripple = noiseScale > 0 ? noiseScale * (0.65 * Math.sin(s * noiseFreq * 1.85) + 0.35 * Math.cos(s * noiseFreq * 3.41 + 1.2)) : 0.0;\n            let y;\n            if (isLogMetric) {\n              const logPure = Math.log10(pureVal);\n              const logVal = logPure + ripple;\n              const clampedLog = Math.max(-4, Math.min(-1, logVal));\n              y = topY + plotH - ((clampedLog - (-4)) / 3.0) * plotH;\n            } else {\n              const val = pureVal + ripple;\n              y = topY + plotH - ((val - minY) / (maxY - minY)) * plotH;\n            }\n            const x = padL + t * plotW;\n            if (s === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n          }\n          ctx.stroke();\n          ctx.setLineDash([]);\n        }\n\n        // Plot All 6 Schemes\n        if (metricType === "cs") {\n          plotLine(t => cs_theo, st.colBound, true, 0.0);\n          plotLine(getCs, st.colDRL, false, 0.035, 1.2);\n          plotLine(getCsRL, st.colRL, false, 0.065, 1.8);\n          plotLine(getCsVB, st.colDRLVB, false, 0.045, 1.5);\n          plotLine(t => cs_sbj_val, st.colSBJ, false, 0.0);\n          plotLine(t => cs_rob_val, st.colRobust, false, 0.08, 3.2);\n        } else if (metricType === "ber") {\n          plotLine(t => pe_bound_val, st.colBound, true, 0.0, 1.0, true);\n          plotLine(getPe, st.colDRL, false, 0.04, 1.1, true);\n          plotLine(getPeRL, st.colRL, false, 0.07, 1.7, true);\n          plotLine(getPeVB, st.colDRLVB, false, 0.08, 1.4, true);\n          plotLine(t => pe_sbj_val, st.colSBJ, false, 0.0, 1.0, true);\n          plotLine(t => pe_rob_val, st.colRobust, false, 0.05, 3.1, true);\n        } else {\n          plotLine(t => u_theo, st.colBound, true, 0.0);\n          plotLine(getU, st.colDRL, false, 0.04, 1.2);\n          plotLine(getURL, st.colRL, false, 0.065, 1.8);\n          plotLine(getUVB, st.colDRLVB, false, 0.05, 1.5);\n          plotLine(t => u_sbj_val, st.colSBJ, false, 0.0);\n          plotLine(t => u_rob_val, st.colRobust, false, 0.07, 3.0);\n        }\n\n        // Live Time Slot Cursor k\n        const curT = slotK / 2000.0;\n        const kX = padL + curT * plotW;\n        ctx.strokeStyle = "#f59e0b";\n        ctx.lineWidth = 1.6;\n        ctx.setLineDash([4, 3]);\n        ctx.beginPath(); ctx.moveTo(kX, topY); ctx.lineTo(kX, topY + plotH); ctx.stroke();\n        ctx.setLineDash([]);\n\n        // Pulsating beacon on DRL curve at slot k\n        let curValDRL;\n        if (metricType === "cs") curValDRL = getCs(curT);\n        else if (metricType === "ber") curValDRL = getPe(curT);\n        else curValDRL = getU(curT);\n\n        let curY;\n        if (isLog) {\n          const logVal = Math.log10(Math.max(1e-4, Math.min(1e-1, curValDRL)));\n          curY = topY + plotH - ((logVal - (-4)) / 3.0) * plotH;\n        } else {\n          curY = topY + plotH - ((curValDRL - minY) / (maxY - minY)) * plotH;\n        }\n\n        const beaconPulse = 4.5 + 1.8 * Math.sin(performance.now() * 0.007);\n        ctx.fillStyle = "#f59e0b";\n        ctx.beginPath(); ctx.arc(kX, curY, beaconPulse, 0, Math.PI * 2); ctx.fill();\n        ctx.strokeStyle = "#ffffff"; ctx.lineWidth = 1.5; ctx.stroke();\n\n        // Cursor badge\n        ctx.fillStyle = "#f59e0b";\n        ctx.font = "bold 10px monospace";\n        ctx.fillText(`\U0001f4cd Slot k=${slotK}`, Math.min(kX + 5, padL + plotW - 95), topY + 13);\n        const curText = metricType === "ber" ? curValDRL.toExponential(1) : curValDRL.toFixed(2);\n        ctx.fillStyle = st.text;\n        ctx.fillText(`DRL: ${curText}`, Math.min(kX + 5, padL + plotW - 75), Math.max(topY + 25, Math.min(topY + plotH - 5, curY - 5)));\n\n        // Legend Box on Right\n        const legX = padL + plotW + 14, legY = topY + 4, legW = 175;\n        const itemSpacing = plotH < 130 ? 16 : 21;\n        const legH = 10 + 6 * itemSpacing;\n\n        ctx.fillStyle = st.legendBg;\n        ctx.fillRect(legX, legY, legW, legH);\n        ctx.strokeStyle = st.legendBorder;\n        ctx.strokeRect(legX, legY, legW, legH);\n\n        const items = [\n          { text: "Theoretical Bound", col: st.colBound, dash: true },\n          { text: "Proposed DRL-FJ", col: st.colDRL, mark: "\u25a0" },\n          { text: "Proposed RL-FJ", col: st.colRL, mark: "\u25b2" },\n          { text: "DRL-VB", col: st.colDRLVB },\n          { text: "SBJ-VLC", col: st.colSBJ },\n          { text: "Robust beamforming", col: st.colRobust }\n        ];\n\n        ctx.font = plotH < 130 ? "10px sans-serif" : "11px sans-serif";\n        items.forEach((it, idx) => {\n          const ly = legY + (plotH < 130 ? 14 : 17) + idx * itemSpacing;\n          ctx.strokeStyle = it.col;\n          ctx.fillStyle = it.col;\n          ctx.setLineDash(it.dash ? [4, 2] : []);\n          ctx.beginPath(); ctx.moveTo(legX + 8, ly - 4); ctx.lineTo(legX + 24, ly - 4); ctx.stroke();\n          ctx.setLineDash([]);\n          if (it.mark) ctx.fillText(it.mark, legX + 12, ly);\n          ctx.fillStyle = st.text;\n          ctx.fillText(it.text, legX + 32, ly);\n        });\n      }\n\n      if (fig6SubMetric === "all") {\n        const topMargin = 22;\n        const gap = 38;\n        const totalGap = 2 * gap;\n        const availH = H - topMargin - 32;\n        const panelH = Math.max(95, Math.floor((availH - totalGap) / 3));\n\n        renderPlot(topMargin, panelH, "cs", "(a) Secrecy rate of the VLC system (bps/Hz)");\n        renderPlot(topMargin + panelH + gap, panelH, "ber", "(b) BER of the legitimate user Bob (4-PAM)");\n        renderPlot(topMargin + (panelH + gap) * 2, panelH, "utility", "(c) Utility of the VLC system: u = c_s - \u03b4\u2081�p_e - \u03b4\u2082�E");\n      } else {\n        const title = fig6SubMetric === "cs" ? "(a) Secrecy rate of the VLC system (bps/Hz)" :\n          (fig6SubMetric === "ber" ? "(b) BER of the legitimate user Bob (4-PAM)" : "(c) Utility of the VLC system: u = c_s - \u03b4\u2081�p_e - \u03b4\u2082�E");\n        renderPlot(40, H - 90, fig6SubMetric, title);\n      }\n    }\n\n    // -------------------------------------------------------------------------\n    // FIGURE 7: PERFORMANCE VS SNR (4 TO 20 dB) (DYNAMIC PAPER FIG 7)\n    // -------------------------------------------------------------------------\n    function drawFig7() {\n      const W = cStage.width, H = cStage.height;\n      const v = getFormValues();\n      const res = computeSystemState(v.bob, v.eve, v.snr, v.alpha, v.delta1, v.delta2);\n      const st = getThemeStyles();\n\n      ctx.fillStyle = st.bg;\n      ctx.fillRect(0, 0, W, H);\n\n      const snrPoints = [4, 6, 8, 10, 12, 14, 16, 18, 20];\n      const minS = 4.0, maxS = 20.0;\n\n      // 1. Dynamic Physical Scaling based on active geometry & channel gains:\n      const d_be = res.d_be;\n      // When Eve gets within 0.40m of Bob, Lambertian spatial separation collapses\n      const distScale = d_be < 0.40 ? Math.max(0, d_be / 0.40) : 1.0;\n      const hAB_nom = 2.718e-5;\n      const bobGainScale = Math.min(1.25, Math.max(0.60, res.h_AB / hAB_nom));\n\n      // Jammer energy consumptions for Eq. (7)\n      const E_zf = res.schemes.zf.energy;\n      const E_drl = Math.max(0.60, E_zf * 0.72);\n      const E_rl  = Math.max(0.80, E_zf * 0.85);\n      const E_sbj = Math.max(0.90, E_zf * 0.95);\n      const E_rob = Math.max(1.10, E_zf * 1.15);\n\n      // (a) Dynamic Secrecy Rate (bps/Hz)\n      function getCsVal(s, scheme) {\n        const nomBase = 1.76 + (4.40 - 1.76) * ((s - 4.0) / 16.0);\n        const physicalRate = nomBase * distScale * (0.80 + 0.20 * bobGainScale);\n        if (scheme === "drl") return Math.max(0, physicalRate);\n        if (scheme === "rl") return Math.max(0, physicalRate * 0.904);\n        if (scheme === "sbj") return Math.max(0, physicalRate * 0.868);\n        if (scheme === "robust") return Math.max(0, physicalRate * 0.757);\n        return 0;\n      }\n\n      // (b) Dynamic Bob 4-PAM BER (Calibrated to IEEE TWC 2024 Fig. 7(b))\n      function getBerVal(s, scheme) {\n        const tables = {\n          drl:    [2.3e-3, 2.0e-3, 1.8e-3, 1.6e-3, 1.5e-3, 9.0e-4, 5.0e-4, 2.5e-4, 1.0e-4],\n          rl:     [1.0e-2, 9.0e-3, 8.5e-3, 7.5e-3, 6.0e-3, 4.5e-3, 3.8e-3, 2.2e-3, 1.2e-3],\n          sbj:    [3.0e-2, 2.8e-2, 2.8e-2, 2.2e-2, 1.6e-2, 1.4e-2, 1.2e-2, 9.0e-3, 7.0e-3],\n          robust: [5.0e-2, 4.8e-2, 4.5e-2, 4.2e-2, 4.0e-2, 4.0e-2, 4.1e-2, 4.0e-2, 3.8e-2]\n        };\n        const arr = tables[scheme] || tables.drl;\n        if (s <= 4.0) return arr[0];\n        if (s >= 20.0) return arr[8];\n        const idx = Math.floor((s - 4.0) / 2.0);\n        const frac = (s - 4.0) / 2.0 - idx;\n        const v1 = Math.log10(arr[idx]);\n        const v2 = Math.log10(arr[Math.min(8, idx + 1)]);\n        return Math.pow(10, v1 + frac * (v2 - v1));\n      }\n\n      // (c) Dynamic System Utility u = c_s - \u03b4\u2081�p_e - \u03b4\u2082�E (Eq. 7)\n      function getUtilityVal(s, scheme) {\n        const cs = getCsVal(s, scheme);\n        const pe = getBerVal(s, scheme);\n        let eng = E_drl;\n        if (scheme === "rl") eng = E_rl;\n        else if (scheme === "sbj") eng = E_sbj;\n        else if (scheme === "robust") eng = E_rob;\n        return cs - v.delta1 * pe - v.delta2 * eng;\n      }\n\n      function renderPlot7(topY, plotH, metricType, title) {\n        const padL = 75, padR = 195;\n        const plotW = W - padL - padR;\n\n        // Box & Grid\n        ctx.strokeStyle = st.border;\n        ctx.lineWidth = 1;\n        ctx.strokeRect(padL, topY, plotW, plotH);\n\n        // Subplot Title\n        ctx.fillStyle = st.text;\n        ctx.font = "bold 12px sans-serif";\n        ctx.fillText(title, padL + 6, topY - 7);\n\n        // Y-Axis Configuration\n        let minY = 0.0, maxY = 5.0, isLog = false;\n        if (metricType === "ber") {\n          minY = 1e-4; maxY = 1e-1; isLog = true;\n        } else if (metricType === "utility") {\n          minY = -0.5; maxY = 4.5;\n        }\n\n        ctx.strokeStyle = st.grid;\n        ctx.fillStyle = st.text;\n        ctx.font = "10px monospace";\n\n        if (isLog) {\n          [-4, -3, -2, -1].forEach(exp => {\n            const y = topY + plotH - ((exp - (-4)) / 3.0) * plotH;\n            ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + plotW, y); ctx.stroke();\n            ctx.fillText(`10^${exp}`, padL - 46, y + 4);\n          });\n          ctx.save();\n          ctx.translate(padL - 52, topY + plotH / 2);\n          ctx.rotate(-Math.PI / 2);\n          ctx.font = "bold 11px sans-serif";\n          ctx.fillText("BER", -12, 0);\n          ctx.restore();\n        } else {\n          const yStep = plotH < 130 ? 1.0 : 0.5;\n          for (let val = minY; val <= maxY + 0.05; val += yStep) {\n            const y = topY + plotH - ((val - minY) / (maxY - minY)) * plotH;\n            ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + plotW, y); ctx.stroke();\n            ctx.fillText(val.toFixed(1), padL - 32, y + 4);\n          }\n          ctx.save();\n          ctx.translate(padL - 40, topY + plotH / 2);\n          ctx.rotate(-Math.PI / 2);\n          ctx.font = "bold 11px sans-serif";\n          ctx.fillText(metricType === "cs" ? "Secrecy rate (bps/Hz)" : "Utility", -50, 0);\n          ctx.restore();\n        }\n\n        // X-Axis Grid & Labels\n        snrPoints.forEach(s => {\n          const x = padL + ((s - minS) / (maxS - minS)) * plotW;\n          ctx.beginPath(); ctx.moveTo(x, topY); ctx.lineTo(x, topY + plotH); ctx.stroke();\n          ctx.fillText(s, x - 5, topY + plotH + 15);\n        });\n        ctx.font = "bold 11px sans-serif";\n        ctx.fillText("Transmit SNR (dB)", padL + plotW / 2 - 45, topY + plotH + 28);\n\n        // Helper to Draw Scheme Curves\n        function plotLine7(scheme, color, markerType) {\n          ctx.strokeStyle = color;\n          ctx.lineWidth = 1.9;\n          ctx.beginPath();\n\n          // High-resolution smooth curve (step by 0.25 dB)\n          const steps = 64;\n          for (let stp = 0; stp <= steps; stp++) {\n            const s = minS + (stp / steps) * (maxS - minS);\n            let val;\n            if (metricType === "cs") val = getCsVal(s, scheme);\n            else if (metricType === "ber") val = getBerVal(s, scheme);\n            else val = getUtilityVal(s, scheme);\n\n            let y;\n            if (isLog) {\n              const logVal = Math.log10(Math.max(1e-4, Math.min(1e-1, val)));\n              y = topY + plotH - ((logVal - (-4)) / 3.0) * plotH;\n            } else {\n              y = topY + plotH - ((val - minY) / (maxY - minY)) * plotH;\n            }\n            const x = padL + ((s - minS) / (maxS - minS)) * plotW;\n            if (stp === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n          }\n          ctx.stroke();\n\n          // Discrete IEEE Markers at snrPoints\n          ctx.fillStyle = color;\n          snrPoints.forEach(s => {\n            let val;\n            if (metricType === "cs") val = getCsVal(s, scheme);\n            else if (metricType === "ber") val = getBerVal(s, scheme);\n            else val = getUtilityVal(s, scheme);\n\n            let y;\n            if (isLog) {\n              const logVal = Math.log10(Math.max(1e-4, Math.min(1e-1, val)));\n              y = topY + plotH - ((logVal - (-4)) / 3.0) * plotH;\n            } else {\n              y = topY + plotH - ((val - minY) / (maxY - minY)) * plotH;\n            }\n            const x = padL + ((s - minS) / (maxS - minS)) * plotW;\n            if (markerType === "square") ctx.fillRect(x - 3.5, y - 3.5, 7, 7);\n            else if (markerType === "triangle") {\n              ctx.beginPath(); ctx.moveTo(x, y - 5); ctx.lineTo(x + 5, y + 4); ctx.lineTo(x - 4, y + 4); ctx.fill();\n            } else if (markerType === "circle") {\n              ctx.beginPath(); ctx.arc(x, y, 4, 0, Math.PI*2); ctx.fill();\n            } else if (markerType === "cross") {\n              ctx.lineWidth = 1.6;\n              ctx.beginPath();\n              ctx.moveTo(x-3.5, y-3.5); ctx.lineTo(x+3.5, y+3.5);\n              ctx.moveTo(x+3.5, y-3.5); ctx.lineTo(x-3.5, y+3.5);\n              ctx.stroke();\n            }\n          });\n        }\n\n        // Draw 4 Published Schemes\n        plotLine7("drl", st.colDRL, "square");\n        plotLine7("rl", st.colRL, "triangle");\n        plotLine7("sbj", st.colSBJ, "circle");\n        plotLine7("robust", st.colRobust, "cross");\n\n        // 2. Current Selected Operating SNR Marker & Live Readout\n        const curX = padL + ((v.snr - minS) / (maxS - minS)) * plotW;\n        ctx.strokeStyle = "#f59e0b";\n        ctx.lineWidth = 1.6;\n        ctx.setLineDash([4, 3]);\n        ctx.beginPath(); ctx.moveTo(curX, topY); ctx.lineTo(curX, topY + plotH); ctx.stroke();\n        ctx.setLineDash([]);\n\n        // Animated Pulsating Beacon on DRL curve at Current Operating SNR\n        let curValDRL;\n        if (metricType === "cs") curValDRL = getCsVal(v.snr, "drl");\n        else if (metricType === "ber") curValDRL = getBerVal(v.snr, "drl");\n        else curValDRL = getUtilityVal(v.snr, "drl");\n\n        let curY;\n        if (isLog) {\n          const logVal = Math.log10(Math.max(1e-4, Math.min(1e-1, curValDRL)));\n          curY = topY + plotH - ((logVal - (-4)) / 3.0) * plotH;\n        } else {\n          curY = topY + plotH - ((curValDRL - minY) / (maxY - minY)) * plotH;\n        }\n\n        const beaconPulse = 5 + 2 * Math.sin(performance.now() * 0.007);\n        ctx.fillStyle = "#f59e0b";\n        ctx.beginPath(); ctx.arc(curX, curY, beaconPulse, 0, Math.PI * 2); ctx.fill();\n        ctx.strokeStyle = "#ffffff"; ctx.lineWidth = 1.5; ctx.stroke();\n\n        // Exact Readout Text\n        const curText = metricType === "ber" ? curValDRL.toExponential(1) : curValDRL.toFixed(2);\n        ctx.fillStyle = "#f59e0b";\n        ctx.font = "bold 10px monospace";\n        ctx.fillText(`\U0001f4cd SNR ${v.snr.toFixed(1)}dB`, Math.min(curX + 6, padL + plotW - 95), topY + 13);\n        ctx.fillStyle = st.text;\n        ctx.fillText(`DRL: ${curText}`, Math.min(curX + 6, padL + plotW - 75), Math.max(topY + 25, Math.min(topY + plotH - 5, curY - 5)));\n\n        // 3. Compact Legend\n        const legX = padL + plotW + 14, legY = topY + 4, legW = 175;\n        const itemSpacing = plotH < 130 ? 17 : 22;\n        const legH = 10 + 4 * itemSpacing;\n\n        ctx.fillStyle = st.legendBg;\n        ctx.fillRect(legX, legY, legW, legH);\n        ctx.strokeStyle = st.legendBorder;\n        ctx.strokeRect(legX, legY, legW, legH);\n\n        const items7 = [\n          { text: "Proposed DRL-FJ", col: st.colDRL, mark: "\u25a0" },\n          { text: "Proposed RL-FJ", col: st.colRL, mark: "\u25b2" },\n          { text: "SBJ-VLC", col: st.colSBJ, mark: "\u25cf" },\n          { text: "Robust beamforming", col: st.colRobust, mark: "\u2716" }\n        ];\n\n        ctx.font = plotH < 130 ? "10px sans-serif" : "11px sans-serif";\n        items7.forEach((it, idx) => {\n          const ly = legY + (plotH < 130 ? 15 : 18) + idx * itemSpacing;\n          ctx.strokeStyle = it.col;\n          ctx.fillStyle = it.col;\n          ctx.beginPath(); ctx.moveTo(legX + 8, ly - 4); ctx.lineTo(legX + 24, ly - 4); ctx.stroke();\n          ctx.fillText(it.mark, legX + 12, ly);\n          ctx.fillStyle = st.text;\n          ctx.fillText(it.text, legX + 32, ly);\n        });\n      }\n\n      if (fig7SubMetric === "all") {\n        const topMargin = 22;\n        const gap = 38;\n        const totalGap = 2 * gap;\n        const availH = H - topMargin - 32;\n        const panelH = Math.max(95, Math.floor((availH - totalGap) / 3));\n\n        renderPlot7(topMargin, panelH, "cs", "(a) Secrecy rate of the VLC system (bps/Hz)");\n        renderPlot7(topMargin + panelH + gap, panelH, "ber", "(b) BER of the legitimate receiver Bob (4-PAM)");\n        renderPlot7(topMargin + (panelH + gap) * 2, panelH, "utility", "(c) Utility of the VLC system: u = c_s - \u03b4\u2081�p_e - \u03b4\u2082�E");\n      } else {\n        const title = fig7SubMetric === "cs" ? "(a) Secrecy rate of the VLC system (bps/Hz)" :\n          (fig7SubMetric === "ber" ? "(b) BER of the legitimate receiver Bob (4-PAM)" : "(c) Utility of the VLC system: u = c_s - \u03b4\u2081�p_e - \u03b4\u2082�E");\n        renderPlot7(40, H - 90, fig7SubMetric, title);\n      }\n    }\n\n    // -------------------------------------------------------------------------\n    // 3D ROOM & LIGHT BEAMS VIEW (EXPANDED & IMMERSIVE VIEWPORT)\n    // -------------------------------------------------------------------------\n    function draw3DRoomScene() {\n      const W = cStage.width, H = cStage.height;\n      const v = getFormValues();\n      const res = computeSystemState(v.bob, v.eve, v.snr, v.alpha, v.delta1, v.delta2);\n      const st = getThemeStyles();\n\n      ctx.fillStyle = st.bg;\n      ctx.fillRect(0, 0, W, H);\n\n      function projectRoom(x, y, z) {\n        // Center coordinates relative to room centroid (2.5, 2.5, 1.5)\n        const dx = x - 2.5, dy = y - 2.5, dz = z - 1.5;\n\n        // Azimuth (yaw) rotation around vertical Z axis\n        const cosAz = Math.cos(roomAngleZ), sinAz = Math.sin(roomAngleZ);\n        const x1 = dx * cosAz - dy * sinAz;\n        const y1 = dx * sinAz + dy * cosAz;\n        const z1 = dz;\n\n        // Elevation (pitch) tilt\n        const cosEl = Math.cos(roomAngleX), sinEl = Math.sin(roomAngleX);\n        const camX = x1;\n        const camY = y1 * cosEl - z1 * sinEl; // depth component\n        const camZ = y1 * sinEl + z1 * cosEl; // elevation component\n\n        // 3D Perspective projection with depth division\n        const camDist = 11.2;\n        const depth = camDist + camY;\n        const focal = (Math.min(W, H) * 1.85) * roomZoom;\n        const scale = focal / Math.max(1.0, depth);\n\n        return {\n          x: W / 2 + camX * scale,\n          y: H / 2 - camZ * scale,\n          scale: scale,\n          depth: depth\n        };\n      }\n\n      // 0. Shaded Floor Base Polygon\n      const fl0 = projectRoom(0, 0, 0);\n      const fl1 = projectRoom(5, 0, 0);\n      const fl2 = projectRoom(5, 5, 0);\n      const fl3 = projectRoom(0, 5, 0);\n      ctx.fillStyle = isPaperTheme ? "rgba(59, 130, 246, 0.04)" : "rgba(30, 58, 138, 0.10)";\n      ctx.beginPath();\n      ctx.moveTo(fl0.x, fl0.y);\n      ctx.lineTo(fl1.x, fl1.y);\n      ctx.lineTo(fl2.x, fl2.y);\n      ctx.lineTo(fl3.x, fl3.y);\n      ctx.closePath();\n      ctx.fill();\n\n      // 1. Floor Tile Grid (0m to 5m at 1m spacing)\n      ctx.strokeStyle = isPaperTheme ? "rgba(0, 0, 0, 0.10)" : "rgba(255, 255, 255, 0.09)";\n      ctx.lineWidth = 0.9;\n      for (let gx = 0; gx <= 5; gx++) {\n        const p1 = projectRoom(gx, 0, 0);\n        const p2 = projectRoom(gx, 5, 0);\n        ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();\n      }\n      for (let gy = 0; gy <= 5; gy++) {\n        const p1 = projectRoom(0, gy, 0);\n        const p2 = projectRoom(5, gy, 0);\n        ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();\n      }\n\n      // Floor corner coordinate markers\n      ctx.fillStyle = st.textMuted;\n      ctx.font = "bold 10px monospace";\n      const p00 = projectRoom(0, 0, 0); ctx.fillText("(0,0)m", p00.x - 18, p00.y + 14);\n      const p50 = projectRoom(5, 0, 0); ctx.fillText("(5,0)m", p50.x + 6, p50.y + 12);\n      const p55 = projectRoom(5, 5, 0); ctx.fillText("(5,5)m", p55.x + 6, p55.y - 6);\n      const p05 = projectRoom(0, 5, 0); ctx.fillText("(0,5)m", p05.x - 30, p05.y - 6);\n\n      // 2. Room 3D Cube Edges\n      ctx.strokeStyle = st.border;\n      ctx.lineWidth = 1.4;\n      const c = [\n        [0,0,0], [5,0,0], [5,5,0], [0,5,0],\n        [0,0,3], [5,0,3], [5,5,3], [0,5,3]\n      ].map(pt => projectRoom(...pt));\n      [[0,1],[1,2],[2,3],[3,0],[4,5],[5,6],[6,7],[7,4],[0,4],[1,5],[2,6],[3,7]].forEach(([i, j]) => {\n        ctx.beginPath(); ctx.moveTo(c[i].x, c[i].y); ctx.lineTo(c[j].x, c[j].y); ctx.stroke();\n      });\n\n      // Ceiling Plane\n      ctx.fillStyle = isPaperTheme ? "rgba(168, 85, 247, 0.03)" : "rgba(168, 85, 247, 0.06)";\n      ctx.beginPath();\n      ctx.moveTo(c[4].x, c[4].y); ctx.lineTo(c[5].x, c[5].y);\n      ctx.lineTo(c[6].x, c[6].y); ctx.lineTo(c[7].x, c[7].y);\n      ctx.closePath(); ctx.fill();\n\n      const pAlice = projectRoom(...ALICE);\n      const pBob = projectRoom(...v.bob);\n      const pEve = projectRoom(...v.eve);\n\n      // 3. Vertical Drop Lines & Shadows on Floor\n      // Alice drop line to floor:\n      const pAliceFloor = projectRoom(2.5, 2.5, 0);\n      ctx.strokeStyle = "rgba(245, 158, 11, 0.3)";\n      ctx.setLineDash([3, 3]);\n      ctx.beginPath(); ctx.moveTo(pAlice.x, pAlice.y); ctx.lineTo(pAliceFloor.x, pAliceFloor.y); ctx.stroke();\n      ctx.setLineDash([]);\n      ctx.fillStyle = "rgba(245, 158, 11, 0.15)";\n      ctx.beginPath(); ctx.ellipse(pAliceFloor.x, pAliceFloor.y, 16, 9, 0, 0, Math.PI*2); ctx.fill();\n\n      // Bob drop line & receiver ring:\n      const pBobFloor = projectRoom(v.bob[0], v.bob[1], 0);\n      ctx.strokeStyle = "rgba(59, 130, 246, 0.45)";\n      ctx.setLineDash([3, 3]);\n      ctx.beginPath(); ctx.moveTo(pBob.x, pBob.y); ctx.lineTo(pBobFloor.x, pBobFloor.y); ctx.stroke();\n      ctx.setLineDash([]);\n      ctx.fillStyle = "rgba(59, 130, 246, 0.18)";\n      ctx.beginPath(); ctx.ellipse(pBobFloor.x, pBobFloor.y, 16, 9, 0, 0, Math.PI*2); ctx.fill();\n\n      // Eve drop line & wiretap ring:\n      const pEveFloor = projectRoom(v.eve[0], v.eve[1], 0);\n      ctx.strokeStyle = "rgba(239, 68, 68, 0.45)";\n      ctx.setLineDash([3, 3]);\n      ctx.beginPath(); ctx.moveTo(pEve.x, pEve.y); ctx.lineTo(pEveFloor.x, pEveFloor.y); ctx.stroke();\n      ctx.setLineDash([]);\n      ctx.fillStyle = "rgba(239, 68, 68, 0.18)";\n      ctx.beginPath(); ctx.ellipse(pEveFloor.x, pEveFloor.y, 16, 9, 0, 0, Math.PI*2); ctx.fill();\n\n      // Distance Line between Bob and Eve\n      ctx.strokeStyle = "rgba(255, 255, 255, 0.35)";\n      ctx.setLineDash([3, 3]);\n      ctx.beginPath(); ctx.moveTo(pBob.x, pBob.y); ctx.lineTo(pEve.x, pEve.y); ctx.stroke();\n      ctx.setLineDash([]);\n      const midX = (pBob.x + pEve.x) / 2;\n      const midY = (pBob.y + pEve.y) / 2;\n      ctx.fillStyle = st.text;\n      ctx.font = "bold 11px monospace";\n      ctx.fillText(`${res.d_be.toFixed(2)}m`, midX + 6, midY - 6);\n\n      // 4. Optical Signal Beams\n      // Alice to Bob: Main Confidential Beam\n      ctx.strokeStyle = "rgba(52, 211, 153, 0.9)";\n      ctx.lineWidth = 3.5;\n      ctx.beginPath(); ctx.moveTo(pAlice.x, pAlice.y); ctx.lineTo(pBob.x, pBob.y); ctx.stroke();\n\n      // Alice to Eve: Eavesdropping Leakage Beam\n      ctx.setLineDash([5, 4]);\n      ctx.strokeStyle = "rgba(245, 158, 11, 0.55)";\n      ctx.lineWidth = 1.8;\n      ctx.beginPath(); ctx.moveTo(pAlice.x, pAlice.y); ctx.lineTo(pEve.x, pEve.y); ctx.stroke();\n      ctx.setLineDash([]);\n\n      // 4 Jammers to Eve (Friendly Jamming Wavefronts)\n      JAMMERS.forEach((j, idx) => {\n        const pj = projectRoom(...j);\n        const w_mag = Math.abs(res.w_zf[idx]);\n        ctx.strokeStyle = `rgba(192, 132, 252, ${0.35 + 0.65 * w_mag})`;\n        ctx.lineWidth = 1.5 + 3.0 * w_mag;\n        ctx.beginPath(); ctx.moveTo(pj.x, pj.y); ctx.lineTo(pEve.x, pEve.y); ctx.stroke();\n\n        // Null space trace to Bob\n        ctx.setLineDash([2, 5]);\n        ctx.strokeStyle = "rgba(56, 189, 248, 0.25)";\n        ctx.lineWidth = 1.0;\n        ctx.beginPath(); ctx.moveTo(pj.x, pj.y); ctx.lineTo(pBob.x, pBob.y); ctx.stroke();\n        ctx.setLineDash([]);\n      });\n\n      // 5. Animated Flowing Photons\n      if (isTransmitting) {\n        const pTime = performance.now() * 0.001 * simSpeed;\n        for (let pt = 0; pt < 14; pt++) {\n          const prog = (pTime + pt * 0.08) % 1.0;\n          // Data photon to Bob\n          const bx = pAlice.x + (pBob.x - pAlice.x) * prog;\n          const by = pAlice.y + (pBob.y - pAlice.y) * prog;\n          ctx.fillStyle = "#34d399";\n          ctx.beginPath(); ctx.arc(bx, by, 3.8, 0, Math.PI*2); ctx.fill();\n\n          // Leakage photon to Eve\n          const ex = pAlice.x + (pEve.x - pAlice.x) * prog;\n          const ey = pAlice.y + (pEve.y - pAlice.y) * prog;\n          ctx.fillStyle = "#f59e0b";\n          ctx.beginPath(); ctx.arc(ex, ey, 3.0, 0, Math.PI*2); ctx.fill();\n\n          // Jamming pulse from Jammer to Eve\n          const jIdx = pt % 4;\n          const pj = projectRoom(...JAMMERS[jIdx]);\n          const jx = pj.x + (pEve.x - pj.x) * prog;\n          const jy = pj.y + (pEve.y - pj.y) * prog;\n          ctx.fillStyle = "#c084fc";\n          ctx.beginPath(); ctx.arc(jx, jy, 3.2, 0, Math.PI*2); ctx.fill();\n        }\n      }\n\n      // 6. Transceiver Nodes\n      // Alice Node (Tx)\n      ctx.fillStyle = "gold";\n      ctx.beginPath(); ctx.arc(pAlice.x, pAlice.y, 11, 0, Math.PI*2); ctx.fill();\n      ctx.strokeStyle = "#fff"; ctx.lineWidth = 2.5; ctx.stroke();\n      ctx.fillStyle = st.text; ctx.font = "bold 13px sans-serif";\n      ctx.fillText("Alice Tx (2.5, 2.5, 3.0)m", pAlice.x + 15, pAlice.y + 5);\n\n      // Bob Node (Rx)\n      ctx.fillStyle = "#3b82f6";\n      ctx.beginPath(); ctx.arc(pBob.x, pBob.y, 11, 0, Math.PI*2); ctx.fill();\n      ctx.strokeStyle = "#fff"; ctx.lineWidth = 2.5; ctx.stroke();\n      // Null-space Protection Pulsating Halo\n      const ringPulse = 20 + 4 * Math.sin(performance.now() * 0.005);\n      ctx.strokeStyle = "rgba(52, 211, 153, 0.7)";\n      ctx.lineWidth = 2.0;\n      ctx.beginPath(); ctx.arc(pBob.x, pBob.y, ringPulse, 0, Math.PI*2); ctx.stroke();\n      ctx.fillStyle = st.text; ctx.font = "bold 13px sans-serif";\n      ctx.fillText(`Bob Rx (${v.bob[0].toFixed(2)}, ${v.bob[1].toFixed(2)}, 0.85)m`, pBob.x + 15, pBob.y + 5);\n\n      // Eve Node (Wiretapper)\n      ctx.fillStyle = "#ef4444";\n      ctx.beginPath(); ctx.arc(pEve.x, pEve.y, 11, 0, Math.PI*2); ctx.fill();\n      ctx.strokeStyle = "#fff"; ctx.lineWidth = 2.5; ctx.stroke();\n      // Jamming Impact Warning Ring\n      const evePulse = 18 + 3 * Math.cos(performance.now() * 0.006);\n      ctx.strokeStyle = "rgba(239, 68, 68, 0.6)";\n      ctx.lineWidth = 1.8;\n      ctx.beginPath(); ctx.arc(pEve.x, pEve.y, evePulse, 0, Math.PI*2); ctx.stroke();\n      ctx.fillStyle = st.text; ctx.font = "bold 13px sans-serif";\n      ctx.fillText(`Eve Rx (${v.eve[0].toFixed(2)}, ${v.eve[1].toFixed(2)}, 0.85)m`, pEve.x + 15, pEve.y + 5);\n\n      // 4 Jammers\n      JAMMERS.forEach((j, idx) => {\n        const pj = projectRoom(...j);\n        ctx.fillStyle = "#d946ef";\n        ctx.beginPath(); ctx.arc(pj.x, pj.y, 9, 0, Math.PI*2); ctx.fill();\n        ctx.strokeStyle = "#fff"; ctx.lineWidth = 2.0; ctx.stroke();\n        ctx.fillStyle = st.text; ctx.font = "bold 11px sans-serif";\n        ctx.fillText(`Jammer J${idx+1} (${j[0]}, ${j[1]}, 3.0)m`, pj.x + 12, pj.y + 4);\n      });\n    }\n\n    // =========================================================================\n    // 6. MASTER RENDER DISPATCHER\n    // =========================================================================\n    function drawStage() {\n      if (activeMainView === "fig5") drawFig5();\n      else if (activeMainView === "fig6") drawFig6();\n      else if (activeMainView === "fig7") drawFig7();\n      else if (activeMainView === "room3d") draw3DRoomScene();\n    }\n\n    // Update Telemetry & Text Displays\n    function updateUI() {\n      const v = getFormValues();\n\n      document.getElementById("vBobX").innerText = v.bob[0].toFixed(2);\n      document.getElementById("vBobY").innerText = v.bob[1].toFixed(2);\n      document.getElementById("vEveX").innerText = v.eve[0].toFixed(2);\n      document.getElementById("vEveY").innerText = v.eve[1].toFixed(2);\n      document.getElementById("labelBobPos").innerText = `(${v.bob[0].toFixed(2)}, ${v.bob[1].toFixed(2)}, 0.85) m`;\n      document.getElementById("labelEvePos").innerText = `(${v.eve[0].toFixed(2)}, ${v.eve[1].toFixed(2)}, 0.85) m`;\n\n      document.getElementById("vSnr").innerText = v.snr.toFixed(1) + " dB";\n      document.getElementById("labelSnr").innerText = v.snr.toFixed(1) + " dB";\n      document.getElementById("vAlpha").innerText = (v.alpha * 100).toFixed(0) + "%";\n      document.getElementById("vDelta1").innerText = v.delta1.toFixed(1);\n      document.getElementById("vDelta2").innerText = v.delta2.toFixed(2);\n\n      const res = computeSystemState(v.bob, v.eve, v.snr, v.alpha, v.delta1, v.delta2);\n\n      document.getElementById("vDistance").innerText = res.d_be.toFixed(2) + " m";\n      const distBox = document.getElementById("distanceAlert");\n      const distStat = document.getElementById("vDistanceStatus");\n      if (res.d_be < 0.4) {\n        distBox.className = "alert-banner alert-warn";\n        distStat.innerText = "(\U0001f6a8 CRITICAL: Risk of Interception!)";\n      } else {\n        distBox.className = "alert-banner alert-safe";\n        distStat.innerText = "(Safe Separation)";\n      }\n\n      document.getElementById("dispCs").innerText = res.schemes.drl.cs.toFixed(2);\n      document.getElementById("dispBer").innerText = res.schemes.drl.pe.toExponential(2);\n      document.getElementById("dispUtility").innerText = res.schemes.drl.u.toFixed(2);\n      document.getElementById("dispEveJam").innerText = res.jamming_eve.toExponential(2);\n      document.getElementById("dispNullBob").innerText = `Bob Leakage: ${res.leakage_bob.toExponential(2)}`;\n\n      res.w_zf.forEach((w, i) => {\n        const fill = document.getElementById(`fillJ${i+1}`);\n        const valText = document.getElementById(`valJ${i+1}`);\n        const pct = Math.abs(w) * 100;\n        fill.style.height = `${pct}%`;\n        fill.style.background = w >= 0 ? "linear-gradient(to top, #8b5cf6, #c084fc)" : "linear-gradient(to top, #ef4444, #f87171)";\n        valText.innerText = (w >= 0 ? "+" : "") + w.toFixed(2);\n      });\n\n      document.getElementById("t_nj_cs").innerText = res.schemes.no_jam.cs.toFixed(4);\n      document.getElementById("t_nj_ber").innerText = res.schemes.no_jam.pe.toExponential(2);\n      document.getElementById("t_nj_u").innerText = res.schemes.no_jam.u.toFixed(4);\n\n      document.getElementById("t_zf_cs").innerText = res.schemes.zf.cs.toFixed(4);\n      document.getElementById("t_zf_ber").innerText = res.schemes.zf.pe.toExponential(2);\n      document.getElementById("t_zf_e").innerText = res.schemes.zf.energy.toFixed(2);\n      document.getElementById("t_zf_u").innerText = res.schemes.zf.u.toFixed(4);\n\n      document.getElementById("t_rl_cs").innerText = res.schemes.rl.cs.toFixed(4);\n      document.getElementById("t_rl_ber").innerText = res.schemes.rl.pe.toExponential(2);\n      document.getElementById("t_rl_e").innerText = res.schemes.rl.energy.toFixed(2);\n      document.getElementById("t_rl_u").innerText = res.schemes.rl.u.toFixed(4);\n\n      document.getElementById("t_drl_cs").innerText = res.schemes.drl.cs.toFixed(4);\n      document.getElementById("t_drl_ber").innerText = res.schemes.drl.pe.toExponential(2);\n      document.getElementById("t_drl_e").innerText = res.schemes.drl.energy.toFixed(2);\n      document.getElementById("t_drl_u").innerText = res.schemes.drl.u.toFixed(4);\n\n      document.getElementById("t_th_cs").innerText = res.schemes.theo.cs.toFixed(4);\n      document.getElementById("t_th_ber").innerText = res.schemes.theo.pe.toExponential(2);\n      document.getElementById("t_th_e").innerText = res.schemes.theo.energy.toFixed(2);\n      document.getElementById("t_th_u").innerText = res.schemes.theo.u.toFixed(4);\n\n      document.getElementById("ch_hAB").innerText = res.h_AB.toExponential(4);\n      document.getElementById("ch_hAE").innerText = res.h_AE.toExponential(4);\n      document.getElementById("ch_hJB").innerText = "[" + res.h_JB.map(v => v.toExponential(2)).join(", ") + "]";\n      document.getElementById("ch_hJE").innerText = "[" + res.h_JE.map(v => v.toExponential(2)).join(", ") + "]";\n\n      drawStage();\n    }\n\n    [slBobX, slBobY, slEveX, slEveY, slSnr, slAlpha, slDelta1, slDelta2].forEach(sl => {\n      sl.addEventListener("input", updateUI);\n    });\n\n    // =========================================================================\n    // 7. REAL-TIME 60 FPS ANIMATION LOOP\n    // =========================================================================\n    function animationLoop(now) {\n      if (isTransmitting) {\n        if (slotK + Math.round(simSpeed * 1.5) >= 2000) {\n          slotK = 2000;\n          isTransmitting = false;\n          const btn = document.getElementById("btnTransPlay");\n          const icon = document.getElementById("transIcon");\n          const text = document.getElementById("transText");\n          btn.classList.add("paused");\n          icon.innerText = "\U0001f504";\n          text.innerText = "CONVERGED (RESTART)";\n        } else {\n          slotK += Math.round(simSpeed * 1.5);\n        }\n        const v = getFormValues();\n        const res = computeSystemState(v.bob, v.eve, v.snr, v.alpha, v.delta1, v.delta2, slotK);\n        totalBits += Math.round(res.schemes.drl.cs * 80 * simSpeed);\n\n        document.getElementById("dispSlot").innerText = `k = ${slotK} / 2000`;\n        document.getElementById("dispBits").innerText = `${(totalBits / 1000).toFixed(1)} kb`;\n        document.getElementById("dispBer").innerText = res.schemes.drl.pe.toExponential(2);\n        document.getElementById("t_drl_ber").innerText = res.schemes.drl.pe.toExponential(2);\n        document.getElementById("t_rl_ber").innerText = res.schemes.rl.pe.toExponential(2);\n      }\n\n      let needsUIUpdate = false;\n\n      if (isEvePatrol) {\n        patrolEveTime += 0.012 * simSpeed;\n        const newEveX = 2.5 + 1.95 * Math.cos(patrolEveTime * 0.65 + evePhaseX);\n        const newEveY = 2.5 + 1.85 * Math.sin(patrolEveTime * 0.85 + evePhaseY);\n        slEveX.value = Math.max(0.35, Math.min(4.65, newEveX)).toFixed(2);\n        slEveY.value = Math.max(0.35, Math.min(4.65, newEveY)).toFixed(2);\n        needsUIUpdate = true;\n      }\n\n      if (isBobPatrol) {\n        patrolBobTime += 0.011 * simSpeed;\n        const newBobX = 2.5 + 1.95 * Math.cos(patrolBobTime * 0.55 + bobPhaseX);\n        const newBobY = 2.5 + 1.85 * Math.sin(patrolBobTime * 0.75 + bobPhaseY);\n        slBobX.value = Math.max(0.35, Math.min(4.65, newBobX)).toFixed(2);\n        slBobY.value = Math.max(0.35, Math.min(4.65, newBobY)).toFixed(2);\n        needsUIUpdate = true;\n      }\n\n      if (needsUIUpdate) {\n        updateUI();\n      }\n\n      // Redraw stage if transmitting, patrols are moving, or active view has live animations\n      if (isTransmitting || isEvePatrol || isBobPatrol || activeMainView === "room3d" || activeMainView === "fig7" || activeMainView === "fig6") {\n        drawStage();\n      }\n\n      requestAnimationFrame(animationLoop);\n    }\n\n    // Initialize layout and launch\n    setTimeout(() => {\n      renderSubControlsBar();\n      resizeCanvas();\n      updateUI();\n      requestAnimationFrame(animationLoop);\n    }, 60);\n  </script>\n</body>\n</html>\n'

